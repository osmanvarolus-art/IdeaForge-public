def youtube_search(query: str, max_results: int = 5):
    """Search YouTube via yt-dlp and return structured results."""
    try:
        result = run(["yt-dlp", f"ytsearch{max_results}:{query}",
                      "--dump-json", "--no-download"], timeout=60)
        results = []
        for line in result.stdout.strip().split('\n'):
            if not line.strip():
                continue
            try:
                data = json.loads(line)
                results.append({
                    "video_id": data.get("id", ""),
                    "title": data.get("title", "Unknown"),
                    "channel": data.get("channel", data.get("uploader", "Unknown")),
                    "duration": data.get("duration_string", ""),
                    "duration_seconds": data.get("duration", 0),
                    "view_count": data.get("view_count", 0),
                    "upload_date": data.get("upload_date", ""),
                    "url": data.get("webpage_url", f"https://www.youtube.com/watch?v={data.get('id', '')}"),
                    "thumbnail": data.get("thumbnail", ""),
                    "description": (data.get("description", "") or "")[:200],
                })
            except json.JSONDecodeError:
                continue
        return results
    except Exception as e:
        print(f"YouTube search error: {e}")
        return []

def youtube_api_search(query: str, max_results: int = 10) -> list:
    """Search YouTube via Data API v3. Falls back to yt-dlp if no API key."""
    if not YOUTUBE_API_KEY:
        return youtube_search(query, max_results)
    try:
        import urllib.request
        params = urllib.parse.urlencode({
            "part": "snippet", "q": query, "type": "video",
            "maxResults": min(max_results, 50), "order": "relevance",
            "key": YOUTUBE_API_KEY,
        })
        url = f"https://www.googleapis.com/youtube/v3/search?{params}"
        req = urllib.request.Request(url, headers={"User-Agent": "IdeaForge/3.0"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read())

        results = []
        video_ids = [item["id"]["videoId"] for item in data.get("items", []) if item["id"].get("videoId")]

        # Batch fetch video details for duration/views
        details = {}
        if video_ids:
            det_params = urllib.parse.urlencode({
                "part": "contentDetails,statistics", "id": ",".join(video_ids),
                "key": YOUTUBE_API_KEY,
            })
            det_url = f"https://www.googleapis.com/youtube/v3/videos?{det_params}"
            det_req = urllib.request.Request(det_url, headers={"User-Agent": "IdeaForge/3.0"})
            with urllib.request.urlopen(det_req, timeout=30) as det_resp:
                det_data = json.loads(det_resp.read())
            for item in det_data.get("items", []):
                dur_iso = item.get("contentDetails", {}).get("duration", "")
                views = int(item.get("statistics", {}).get("viewCount", 0))
                # Parse ISO 8601 duration (PT1H23M45S)
                dur_secs = 0
                m = re.match(r'PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?', dur_iso)
                if m:
                    dur_secs = int(m.group(1) or 0)*3600 + int(m.group(2) or 0)*60 + int(m.group(3) or 0)
                details[item["id"]] = {"duration_seconds": dur_secs, "view_count": views}

        for item in data.get("items", []):
            vid_id = item["id"].get("videoId")
            if not vid_id:
                continue
            snippet = item.get("snippet", {})
            det = details.get(vid_id, {})
            dur_s = det.get("duration_seconds", 0)
            dur_str = f"{dur_s//3600}:{(dur_s%3600)//60:02d}:{dur_s%60:02d}" if dur_s >= 3600 else f"{dur_s//60}:{dur_s%60:02d}"
            results.append({
                "video_id": vid_id,
                "title": snippet.get("title", "Unknown"),
                "channel": snippet.get("channelTitle", "Unknown"),
                "duration": dur_str,
                "duration_seconds": dur_s,
                "view_count": det.get("view_count", 0),
                "upload_date": (snippet.get("publishedAt", "")[:10]).replace("-", ""),
                "url": f"https://www.youtube.com/watch?v={vid_id}",
                "thumbnail": snippet.get("thumbnails", {}).get("medium", {}).get("url", ""),
                "description": (snippet.get("description", "") or "")[:200],
                "source_type": "youtube",
            })
        return results
    except Exception as e:
        print(f"YouTube Data API error: {e}, falling back to yt-dlp")
        return youtube_search(query, max_results)


def web_search_grounded(query: str, max_results: int = 10) -> list:
    """Search the web using Gemini Google Search grounding. Returns structured results."""
    if ai_backend != "gemini":
        return []
    try:
        prompt = f"""Search the web for: {query}

Find {max_results} relevant results. For EACH result, provide:
- title: the page title
- url: the actual source URL
- domain: the website domain
- description: 1-2 sentence summary
- published_date: approximate publication date (YYYY-MM-DD or empty)

Return STRICT JSON array (no markdown fences):
[{{"title":"...","url":"...","domain":"...","description":"...","published_date":"..."}}]"""

        grounding_urls = {}
        text, _, _ = llm_call(prompt, max_tokens=2000, temperature=0.2,
                              grounding_urls=grounding_urls)
        clean = re.sub(r'^```json\s*|```\s*$', '', text, flags=re.MULTILINE).strip()

        results = []
        try:
            parsed = parse_json_object(clean)
            for item in parsed[:max_results]:
                results.append({
                    "title": item.get("title", "Unknown"),
                    "url": item.get("url", ""),
                    "channel": item.get("domain", ""),
                    "description": (item.get("description", "") or "")[:200],
                    "upload_date": (item.get("published_date", "") or "").replace("-", "")[:8],
                    "duration": "",
                    "duration_seconds": 0,
                    "view_count": 0,
                    "video_id": "",
                    "thumbnail": "",
                    "source_type": "web",
                })
        except ValueError:
            pass

        # Supplement with grounding URLs not already in results
        result_urls = {r["url"] for r in results}
        for url, title in grounding_urls.items():
            if url not in result_urls and len(results) < max_results:
                domain = urlparse(url).netloc.replace("www.", "")
                results.append({
                    "title": title or domain,
                    "url": url,
                    "channel": domain,
                    "description": "",
                    "upload_date": "",
                    "duration": "",
                    "duration_seconds": 0,
                    "view_count": 0,
                    "video_id": "",
                    "thumbnail": "",
                    "source_type": "web",
                })
        return results
    except Exception as e:
        print(f"Web search grounding error: {e}")
        return []


