def build_brain_export():
    """Assemble founder brain JSON v2: profile, calibration, patterns, anchors, research insights, thresholds."""
    patterns = compute_patterns()
    calibration = None
    with db() as conn:
        conn.row_factory = sqlite3.Row
        row = conn.execute("SELECT * FROM calibration_log ORDER BY id DESC LIMIT 1").fetchone()
        if row:
            calibration = dict(row)

        # Verdict anchors: top 3 BUILD+shipped, top 3 SKIP confirmed
        build_anchors = conn.execute("""
            SELECT id, video_title, eval_fit_score, eval_one_sentence, outcome
            FROM ideas WHERE eval_verdict='BUILD' AND outcome='shipped'
            ORDER BY eval_fit_score DESC LIMIT 3
        """).fetchall()
        skip_anchors = conn.execute("""
            SELECT id, video_title, eval_fit_score, eval_one_sentence, outcome
            FROM ideas WHERE eval_verdict='SKIP' AND outcome='abandoned'
            ORDER BY eval_fit_score ASC LIMIT 3
        """).fetchall()

    # v2 additions: per-complexity thresholds, per-domain thresholds, research insights
    complexity_thresholds = compute_per_complexity_thresholds()
    domain_thresholds = compute_per_domain_thresholds()
    research_funnel = compute_research_funnel()
    topic_performance = compute_topic_performance()

    # Build research_insights section
    research_insights = None
    if research_funnel.get("ready"):
        best_topics = []
        worst_topics = []
        if topic_performance.get("ready"):
            for t in topic_performance["topics"]:
                entry = {"topic": t["name"], "ship_rate": t.get("ship_rate") or 0}
                if t.get("ship_rate") and t["ship_rate"] > 0:
                    best_topics.append(entry)
                elif t.get("total_ingested", 0) >= 2:
                    worst_topics.append(entry)
            best_topics.sort(key=lambda x: x["ship_rate"], reverse=True)
            worst_topics.sort(key=lambda x: x["ship_rate"])

        avg_candidates = round(research_funnel["total_candidates"] / research_funnel["total_runs"], 1) if research_funnel["total_runs"] else 0
        avg_ingest_rate = round(research_funnel["total_ingested"] / research_funnel["total_candidates"], 3) if research_funnel["total_candidates"] else 0

        research_insights = {
            "total_research_runs": research_funnel["total_runs"],
            "avg_candidates_per_run": avg_candidates,
            "avg_ingest_rate": avg_ingest_rate,
            "avg_research_to_ship_rate": research_funnel.get("research_to_ship_rate"),
            "best_topics": best_topics[:5],
            "worst_topics": worst_topics[:5],
        }

    brain = {
        "version": "2.0",
        "exported_at": now_iso(),
        "profile": EVAL_PROFILE,
        "calibration": calibration,
        "patterns": patterns if patterns.get("ready") else None,
        "verdict_anchors": {
            "build_shipped": [dict(r) for r in build_anchors],
            "skip_confirmed": [dict(r) for r in skip_anchors],
        },
        "effective_threshold": patterns.get("effective_threshold") or (calibration or {}).get("effective_threshold"),
        "complexity_thresholds": complexity_thresholds.get("thresholds") if complexity_thresholds.get("ready") else None,
        "domain_thresholds": domain_thresholds.get("domains") if domain_thresholds.get("ready") else None,
        "research_insights": research_insights,
    }

    # SHA-256 signature
    brain_str = json.dumps(brain, sort_keys=True)
    brain["signature"] = hashlib.sha256(brain_str.encode()).hexdigest()[:16]

    # Save files
    brain_dir = os.path.join(DATA_DIR, "brain")
    os.makedirs(brain_dir, exist_ok=True)
    json_path = os.path.join(brain_dir, "brain-latest.json")
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(brain, f, indent=2)
    md_path = os.path.join(brain_dir, "FOUNDER-BRAIN.md")
    with open(md_path, "w", encoding="utf-8") as f:
        f.write(generate_brain_markdown(brain))

    return brain

def generate_brain_markdown(brain):
    """Convert brain export to CLAUDE.md-compatible markdown."""
    lines = ["# Founder Brain (IdeaForge Export)", ""]
    lines.append(f"*Exported: {brain['exported_at']}*")
    lines.append(f"*Signature: {brain.get('signature', 'N/A')}*")
    lines.append("")

    # Profile
    p = brain.get("profile", {})
    lines.append("## Developer Profile")
    lines.append(f"- {p.get('developer_profile', 'N/A')}")
    lines.append(f"- Budget: {p.get('budget', 'N/A')}")
    lines.append(f"- Domain advantage: {p.get('domain_advantage', 'N/A')}")
    lines.append(f"- Style: {p.get('style', 'N/A')}")
    lines.append("")

    # Calibrated thresholds
    lines.append("## Calibrated Thresholds")
    cal = brain.get("calibration") or {}
    et = brain.get("effective_threshold")
    lines.append(f"- Effective build threshold: **{et or 'Not yet calibrated'}**")
    if cal:
        lines.append(f"- BUILD ship rate: {cal.get('build_ship_rate', 'N/A')}")
        lines.append(f"- Avg fit (shipped): {cal.get('avg_fit_shipped', 'N/A')}")
        lines.append(f"- Avg fit (not shipped): {cal.get('avg_fit_not_shipped', 'N/A')}")
    lines.append("")

    # Patterns
    pat = brain.get("patterns")
    if pat:
        lines.append("## Pattern Summary")
        v = pat.get("verdicts", {})
        lines.append(f"- Total evaluated: {pat.get('total_evaluated', 0)}")
        lines.append(f"- Verdict split: BUILD={v.get('BUILD',0)} / SKIP={v.get('SKIP',0)} / PARK={v.get('PARK',0)}")
        avg = pat.get("avg_fit_by_verdict", {})
        lines.append(f"- Avg fit: BUILD={avg.get('BUILD','—')} / SKIP={avg.get('SKIP','—')} / PARK={avg.get('PARK','—')}")
        lines.append("")

    # Verdict anchors
    anchors = brain.get("verdict_anchors", {})
    if anchors.get("build_shipped"):
        lines.append("## Verdict Anchors: BUILD + Shipped")
        for a in anchors["build_shipped"]:
            lines.append(f"- **{a.get('video_title', 'N/A')}** (fit: {a.get('eval_fit_score', '?')}): {a.get('eval_one_sentence', '')}")
        lines.append("")
    if anchors.get("skip_confirmed"):
        lines.append("## Verdict Anchors: SKIP + Confirmed")
        for a in anchors["skip_confirmed"]:
            lines.append(f"- **{a.get('video_title', 'N/A')}** (fit: {a.get('eval_fit_score', '?')}): {a.get('eval_one_sentence', '')}")
        lines.append("")

    # v2: Per-complexity thresholds
    ct = brain.get("complexity_thresholds")
    if ct:
        lines.append("## Per-Complexity Thresholds")
        for level, data in sorted(ct.items()):
            t = data.get("threshold", "—")
            sr = data.get("ship_rate")
            sr_str = f"{int(sr*100)}%" if sr is not None else "—"
            lines.append(f"- Complexity {level}: threshold={t}, ship_rate={sr_str} ({data.get('total', 0)} ideas)")
        lines.append("")

    # v2: Per-domain thresholds
    dt = brain.get("domain_thresholds")
    if dt:
        lines.append("## Per-Domain Thresholds")
        for d in dt[:10]:
            sr = d.get("ship_rate")
            sr_str = f"{int(sr*100)}%" if sr is not None else "—"
            lines.append(f"- **{d['domain']}**: threshold={d.get('threshold', '—')}, ship_rate={sr_str} ({d.get('total', 0)} ideas)")
        lines.append("")

    # v2: Research insights
    ri = brain.get("research_insights")
    if ri:
        lines.append("## Research Insights")
        lines.append(f"- Total research runs: {ri.get('total_research_runs', 0)}")
        lines.append(f"- Avg candidates/run: {ri.get('avg_candidates_per_run', 0)}")
        lines.append(f"- Avg ingest rate: {ri.get('avg_ingest_rate', 0)}")
        r2s = ri.get("avg_research_to_ship_rate")
        lines.append(f"- Research-to-ship rate: {f'{r2s:.1%}' if r2s else '—'}")
        if ri.get("best_topics"):
            lines.append("- Best topics: " + ", ".join(f"{t['topic']} ({t['ship_rate']:.0%})" for t in ri["best_topics"]))
        if ri.get("worst_topics"):
            lines.append("- Worst topics: " + ", ".join(t["topic"] for t in ri["worst_topics"]))
        lines.append("")

    lines.append("---")
    lines.append(f"*Generated by IdeaForge Brain Export v{brain.get('version', '1.0')}*")
    return "\n".join(lines)


