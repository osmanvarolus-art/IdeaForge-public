def extract_transcript_job(idea_id: int, url: str) -> bool:
    t0 = time.monotonic()
    d = idea_dir(idea_id)

    with db() as conn:
        conn.execute("UPDATE ideas SET extract_status=?, updated_at=? WHERE id=?",
                     ("extracting", now_iso(), idea_id))
        log_event(conn, idea_id, "extract:start", url)

    title = None
    try:
        meta = run(["yt-dlp", "--print-json", "--skip-download", url], timeout=60)
        if meta.returncode == 0 and meta.stdout.strip():
            title = json.loads(meta.stdout).get("title")
    except Exception:
        title = None

    try:
        outtmpl = os.path.join(d, "sub.%(ext)s")
        # prefer SRT; allow VTT fallback
        sub = run([
            "yt-dlp", "--skip-download",
            "--write-auto-sub",
            "--sub-langs", "en,en-orig",
            "--sub-format", "srt/vtt",
            "-o", outtmpl,
            url
        ], timeout=240)

        candidates = [fn for fn in os.listdir(d) if fn.endswith(".srt") or fn.endswith(".vtt")]
        if not candidates:
            raise RuntimeError("No subtitles written (.srt/.vtt).")

        candidates.sort(key=lambda x: (0 if x.endswith(".srt") else 1, x))
        chosen = candidates[0]
        raw_path = os.path.join(d, chosen)
        fmt = "srt" if chosen.endswith(".srt") else "vtt"

        raw = open(raw_path, "r", encoding="utf-8", errors="ignore").read()

        # Clean: strip timestamps/indices; keep text lines
        cleaned_lines = []
        for line in raw.splitlines():
            s = line.strip()
            if not s:
                continue
            if re.match(r"^\d+$", s):
                continue
            if "-->" in s:
                continue
            if s.startswith("WEBVTT"):
                continue
            cleaned_lines.append(s)

        cleaned = " ".join(cleaned_lines)
        preview = cleaned[:800]

        clean_path = os.path.join(d, "transcript.cleaned.txt")
        with open(clean_path, "w", encoding="utf-8") as f:
            f.write(cleaned)

        digest = sha256_file(raw_path)
        dur_ms = int((time.monotonic() - t0) * 1000)

        with db() as conn:
            conn.execute("""
              UPDATE ideas
              SET video_title=?, transcript_path=?, transcript_clean_path=?,
                  transcript_format=?, transcript_sha256=?, transcript_preview=?,
                  extract_status=?, extract_duration_ms=?, updated_at=?
              WHERE id=?
            """, (title or "Unknown Video", raw_path, clean_path,
                  fmt, digest, preview, "done", dur_ms, now_iso(), idea_id))
            log_event(conn, idea_id, "extract:done", json.dumps({
                "format": fmt, "sha256": digest, "duration_ms": dur_ms, "stderr_tail": sub.stderr[-400:]
            }))
        return True

    except Exception as e:
        with db() as conn:
            conn.execute("UPDATE ideas SET extract_status=?, last_error=?, updated_at=? WHERE id=?",
                         ("failed", str(e)[:2000], now_iso(), idea_id))
            log_event(conn, idea_id, "extract:failed", str(e))
        return False

