def _normalize_title(title: str) -> str:
    """Normalize title for fuzzy dedup: lowercase, strip punctuation, collapse whitespace."""
    t = re.sub(r'[^\w\s]', '', (title or '').lower())
    return re.sub(r'\s+', ' ', t).strip()

def _title_similar(a: str, b: str) -> bool:
    """Check if two titles are similar enough to be duplicates (>80% word overlap)."""
    wa = set(_normalize_title(a).split())
    wb = set(_normalize_title(b).split())
    if not wa or not wb:
        return False
    overlap = len(wa & wb) / min(len(wa), len(wb))
    return overlap > 0.8

def research_retrieve(plan: dict, mode: str = "youtube") -> list:
    """Execute search plan. Dispatches to YouTube, web, or hybrid retrieval. Returns deduplicated candidates."""
    queries = plan.get("queries", [])
    max_per = min(plan.get("max_per_query", 10), 15)
    all_candidates = []
    seen_urls = set()
    seen_titles = []

    # Existing idea URLs + titles for dedup
    with db() as conn:
        existing_urls = set(r[0] for r in conn.execute(
            "SELECT youtube_url FROM ideas WHERE youtube_url IS NOT NULL AND youtube_url != ''").fetchall())
        existing_titles = [r[0] for r in conn.execute(
            "SELECT video_title FROM ideas WHERE video_title IS NOT NULL AND video_title != ''").fetchall()]

    for q in queries:
        # Determine search function based on mode and query prefix
        query_mode = mode
        clean_q = q
        if q.startswith("yt:"):
            query_mode = "youtube"
            clean_q = q[3:].strip()
        elif q.startswith("web:"):
            query_mode = "web"
            clean_q = q[4:].strip()

        if query_mode == "youtube":
            results = youtube_api_search(clean_q, max_per)
            for r in results:
                r.setdefault("source_type", "youtube")
        elif query_mode == "web":
            results = web_search_grounded(clean_q, max_per)
            for r in results:
                r.setdefault("source_type", "web")
        elif query_mode == "hybrid":
            yt_results = youtube_api_search(clean_q, max_per // 2 + 1)
            for r in yt_results:
                r.setdefault("source_type", "youtube")
            web_results = web_search_grounded(clean_q, max_per // 2 + 1)
            for r in web_results:
                r.setdefault("source_type", "web")
            results = yt_results + web_results
        else:
            results = youtube_api_search(clean_q, max_per)
            for r in results:
                r.setdefault("source_type", "youtube")

        for r in results:
            url = r.get("url", "")
            title = r.get("title", "")
            if url in seen_urls or url in existing_urls:
                continue
            if any(_title_similar(title, et) for et in existing_titles):
                continue
            if any(_title_similar(title, st) for st in seen_titles):
                continue
            seen_urls.add(url)
            seen_titles.append(title)
            all_candidates.append(r)

    return all_candidates


def research_rerank(candidates: list, plan: dict, brief: str) -> list:
    """Score candidates against founder profile and brain. Returns scored list."""
    if not candidates:
        return []

    brain_context = ""
    patterns = compute_patterns()
    if patterns.get("ready"):
        et = patterns.get("effective_threshold")
        bsr = patterns.get("build_ship_rate")
        brain_context = f"""
Brain context:
- Effective threshold: {et or 'N/A'}
- BUILD ship rate: {bsr if bsr is not None else 'N/A'}
"""
    rubric = plan.get("scoring_rubric", {})
    must = plan.get("must_signals", [])
    exclude = plan.get("exclude_signals", [])

    cand_text = ""
    for i, c in enumerate(candidates):
        src = c.get("source_type", "youtube")
        if src == "web":
            cand_text += f"""[{i}] [{src.upper()}] {c.get('title','Unknown')}
  Domain: {c.get('channel','?')} | Date: {c.get('upload_date','?')} | URL: {c.get('url','')[:60]}
  Desc: {(c.get('description','') or '')[:120]}
"""
        else:
            cand_text += f"""[{i}] [{src.upper()}] {c.get('title','Unknown')}
  Channel: {c.get('channel','?')} | Duration: {c.get('duration','?')} | Views: {c.get('view_count',0)} | Date: {c.get('upload_date','?')}
  Desc: {(c.get('description','') or '')[:120]}
"""

    prompt = f"""You are IdeaForge Research Reranker. Score each candidate against the founder profile.

Developer profile:
- {EVAL_PROFILE["developer_profile"]}
- {EVAL_PROFILE["budget"]}
- Domain advantage: {EVAL_PROFILE["domain_advantage"]}
- Style: {EVAL_PROFILE["style"]}
{brain_context}
Research brief: {brief}

Scoring rubric:
- Founder fit: {rubric.get('founder_fit', 'matches solo developer profile')}
- Actionability: {rubric.get('actionability', 'shows buildable techniques')}
- Recency: {rubric.get('recency', 'newer is better')}

Must signals: {', '.join(must) if must else 'none'}
Exclude signals: {', '.join(exclude) if exclude else 'none'}

Candidates:
{cand_text}
Return STRICT JSON array (no markdown fences), one entry per candidate, sorted by score DESC:
[{{"index":0,"score":85,"reason":"one sentence","signals_found":["s1"],"brain_note":"optional"}}]

Rules:
- Score 0-100. Ruthless: clickbait/irrelevant = 0-30, decent = 40-60, strong fit = 70+
- Practical builds > theory. Solo dev > enterprise.
- If exclude_signals found, score 0-20.
- Return ALL candidates.""".strip()

    # Chunk candidates in batches of 15 to stay within token limits
    BATCH = 15
    all_scored = {}
    for start in range(0, len(candidates), BATCH):
        batch = candidates[start:start+BATCH]
        batch_text = ""
        for j, c in enumerate(batch):
            idx = start + j
            src = c.get("source_type", "youtube")
            if src == "web":
                batch_text += f"""[{idx}] [{src.upper()}] {c.get('title','Unknown')}
  Domain: {c.get('channel','?')} | Date: {c.get('upload_date','?')} | URL: {c.get('url','')[:60]}
  Desc: {(c.get('description','') or '')[:120]}
"""
            else:
                batch_text += f"""[{idx}] [{src.upper()}] {c.get('title','Unknown')}
  Channel: {c.get('channel','?')} | Duration: {c.get('duration','?')} | Views: {c.get('view_count',0)} | Date: {c.get('upload_date','?')}
  Desc: {(c.get('description','') or '')[:120]}
"""
        batch_prompt = prompt.replace(cand_text, batch_text)
        try:
            scored = research_json_call(batch_prompt, kind='scores', max_tokens=3000, temperature=0.2)
            for item in scored:
                all_scored[item['index']] = item
        except (ValueError, RuntimeError) as e:
            # Assign default scores to failed batch instead of skipping
            for j in range(len(batch)):
                idx = start + j
                if idx not in all_scored:
                    all_scored[idx] = {
                        "index": idx,
                        "score": 50,  # Neutral score
                        "reason": "Scoring failed - parse error",
                        "signals_found": [],
                        "_error": "batch_scoring_failed"
                    }
            log(f"Assigned default scores to batch {start}-{start+len(batch)-1}")

    for i, c in enumerate(candidates):
        s = all_scored.get(i, {})
        c["score"] = s.get("score", 50)
        c["reason"] = s.get("reason", "Reranker did not score" if i not in all_scored else "")
        c["signals_found"] = s.get("signals_found", [])
        c["brain_note"] = s.get("brain_note", "")

    candidates.sort(key=lambda x: x.get("score", 0), reverse=True)
    return candidates


def research_synthesize(scored: list, brief: str) -> str:
    """AI-generated cross-result pattern synthesis. Returns markdown summary."""
    top_results = sorted(scored, key=lambda x: x.get("score", 0), reverse=True)[:10]
    above_threshold = [c for c in scored if c.get("score", 0) >= 60]

    # Count source types
    yt_count = sum(1 for c in scored if c.get("source_type") == "youtube")
    web_count = sum(1 for c in scored if c.get("source_type") == "web")

    result_summaries = ""
    for i, c in enumerate(top_results, 1):
        src = c.get("source_type", "youtube").upper()
        result_summaries += f"{i}. [{src}] {c.get('title','?')[:60]} (score: {c.get('score',0)}) — {c.get('reason','')[:100]}\n"

    prompt = f"""You are IdeaForge Research Synthesizer. Analyze these research results and extract cross-cutting patterns.

Research brief: {brief}
Total candidates: {len(scored)} ({yt_count} YouTube, {web_count} web)
Above threshold: {len(above_threshold)}

Top results:
{result_summaries}

Write a concise synthesis (3-5 bullet points) covering:
1. What patterns emerge across the top results?
2. What approaches/tools/techniques appear most frequently?
3. What gaps or opportunities did this research reveal?
4. Actionable recommendation for the developer

Keep it under 200 words. Use markdown. Start with a one-line summary.""".strip()

    try:
        text, _, _ = llm_call(prompt, max_tokens=500, temperature=0.3)
        return text.strip()
    except Exception as e:
        return f"Synthesis failed: {e}"


def research_run_job(run_id: int) -> bool:
    """Full research run: plan -> retrieve -> rerank -> synthesize -> persist."""
    with db() as conn:
        row = conn.execute("SELECT prompt, mode FROM research_runs WHERE id=?", (run_id,)).fetchone()
        if not row:
            return False
        brief, mode = row

    try:
        # Step 1: Plan
        with db() as conn:
            conn.execute("UPDATE research_runs SET status='planning', updated_at=? WHERE id=?",
                         (now_iso(), run_id))
        plan = research_planner(brief, mode)
        with db() as conn:
            conn.execute("UPDATE research_runs SET plan_json=?, status='searching', updated_at=? WHERE id=?",
                         (json.dumps(plan), now_iso(), run_id))

        # Step 2: Retrieve (mode-aware)
        candidates = research_retrieve(plan, mode)
        if not candidates:
            with db() as conn:
                conn.execute("UPDATE research_runs SET status='done', total_candidates=0, updated_at=? WHERE id=?",
                             (now_iso(), run_id))
            return True

        # Step 3: Rerank
        with db() as conn:
            conn.execute("UPDATE research_runs SET status='ranking', updated_at=? WHERE id=?",
                         (now_iso(), run_id))
        scored = research_rerank(candidates, plan, brief)

        # Step 4: Persist results
        threshold = 50
        patterns = compute_patterns()
        if patterns.get("effective_threshold"):
            threshold = patterns["effective_threshold"]

        above = 0
        with db() as conn:
            for c in scored:
                if c.get("score", 0) >= threshold:
                    above += 1
                source_type = c.get("source_type", "youtube")
                source_id = c.get("video_id", "") if source_type == "youtube" else ""
                conn.execute("""
                    INSERT INTO research_results
                    (run_id, source_type, source_id, title, url, channel_or_domain,
                     published_at, duration_seconds, view_count, description,
                     score, reason, signals_found, brain_note, raw_json)
                    VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
                """, (run_id, source_type, source_id,
                      c.get("title", ""), c.get("url", ""),
                      c.get("channel", ""),
                      c.get("upload_date", ""),
                      c.get("duration_seconds"),
                      c.get("view_count"),
                      c.get("description", ""),
                      c.get("score"),
                      c.get("reason", ""),
                      json.dumps(c.get("signals_found", [])),
                      c.get("brain_note", ""),
                      json.dumps(c)))

            # Step 5: Synthesize (AI cross-result patterns)
            top5 = sorted(scored, key=lambda x: x.get("score", 0), reverse=True)[:5]
            basic_summary = [f"**{len(scored)}** candidates found, **{above}** above threshold.\n"]
            basic_summary.append("Top results:")
            for i, c in enumerate(top5, 1):
                src_badge = f"[{c.get('source_type','yt').upper()}] " if c.get("source_type") != "youtube" else ""
                basic_summary.append(f"{i}. {src_badge}**{c.get('title','?')[:60]}** (score: {c.get('score',0)}) — {c.get('reason','')[:80]}")

            # Cross-result synthesis (only if enough results)
            if len(scored) >= 3 and ai_backend:
                synthesis = research_synthesize(scored, brief)
                summary_md = "\n".join(basic_summary) + "\n\n---\n\n**Synthesis:**\n" + synthesis
            else:
                summary_md = "\n".join(basic_summary)

            conn.execute("""
                UPDATE research_runs SET status='done', total_candidates=?, total_above_threshold=?, summary_md=?, updated_at=?
                WHERE id=?
            """, (len(scored), above, summary_md, now_iso(), run_id))

        print(f"Research run {run_id}: {len(scored)} candidates, {above} above threshold")
        return True

    except Exception as e:
        print(f"Research run {run_id} failed: {e}")
        with db() as conn:
            conn.execute("UPDATE research_runs SET status='failed', error=?, updated_at=? WHERE id=?",
                         (str(e)[:2000], now_iso(), run_id))
        return False


def research_ingest(run_id: int, result_ids: list) -> list:
    """Ingest selected research results as ideas. Returns list of new idea IDs."""
    new_ids = []
    ts = now_iso()
    with db() as conn:
        for rid in result_ids:
            row = conn.execute("""
                SELECT url, title, source_type FROM research_results
                WHERE id=? AND run_id=? AND idea_id IS NULL
            """, (rid, run_id)).fetchone()
            if not row:
                continue
            url, title, source_type = row
            cur = conn.execute("""
                INSERT INTO ideas
                (youtube_url, video_title, source_kind, extract_status, eval_status, instr_status,
                 research_result_id, created_at, updated_at)
                VALUES (?, ?, ?, 'pending', 'pending', 'pending', ?, ?, ?)
            """, (url, title, source_type, rid, ts, ts))
            idea_id = cur.lastrowid
            conn.execute("UPDATE research_results SET selected=1, idea_id=? WHERE id=?",
                         (idea_id, rid))
            log_event(conn, idea_id, "research:ingest", f"run:{run_id} result:{rid}")
            JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": url,
                       "source_kind": source_type, "chain": ["evaluate", "instruct"]})
            new_ids.append(idea_id)

        ingested = conn.execute(
            "SELECT COUNT(*) FROM research_results WHERE run_id=? AND idea_id IS NOT NULL",
            (run_id,)).fetchone()[0]
        conn.execute("UPDATE research_runs SET total_ingested=?, updated_at=? WHERE id=?",
                     (ingested, now_iso(), run_id))
        # Update brief counters if linked
        brief_row = conn.execute("SELECT brief_id FROM research_runs WHERE id=?", (run_id,)).fetchone()
        if brief_row and brief_row[0]:
            total_brief_ingested = conn.execute("""
                SELECT COUNT(*) FROM research_results rr
                JOIN research_runs rn ON rr.run_id = rn.id
                WHERE rn.brief_id = ? AND rr.idea_id IS NOT NULL
            """, (brief_row[0],)).fetchone()[0]
            # Also recompute hit_rate, total_built, total_shipped
            built = conn.execute("""
                SELECT COUNT(*) FROM ideas i
                JOIN research_results rr ON i.research_result_id = rr.id
                JOIN research_runs rn ON rr.run_id = rn.id
                WHERE rn.brief_id = ? AND i.eval_verdict = 'BUILD'
            """, (brief_row[0],)).fetchone()[0]
            shipped = conn.execute("""
                SELECT COUNT(*) FROM ideas i
                JOIN research_results rr ON i.research_result_id = rr.id
                JOIN research_runs rn ON rr.run_id = rn.id
                WHERE rn.brief_id = ? AND i.outcome = 'shipped'
            """, (brief_row[0],)).fetchone()[0]
            hit_rate = round(shipped / total_brief_ingested, 4) if total_brief_ingested > 0 else None
            conn.execute("""
                UPDATE research_briefs SET total_ingested=?, total_built=?, total_shipped=?, hit_rate=?, updated_at=?
                WHERE id=?
            """, (total_brief_ingested, built, shipped, hit_rate, now_iso(), brief_row[0]))

    return new_ids


