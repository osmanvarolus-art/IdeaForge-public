def factory_goal_status(goal):
    if not isinstance(goal, str) or not re.fullmatch(r"goal-[A-Za-z0-9-]+", goal):
        return "unknown"
    root = os.path.expanduser(os.environ.get("IDEAFORGE_GOALS_DIR", "~/.local/state/north-star/goals"))
    try:
        with open(os.path.join(root, goal, "goal.json"), encoding="utf-8") as stream:
            record = json.load(stream)
        status = record.get("status")
        return status if isinstance(status, str) and status else "unknown"
    except (OSError, ValueError, AttributeError):
        return "unknown"


def refresh_factory_outcomes():
    """Project goal and decision evidence without writing the owner's outcome columns."""
    root = Path(os.path.expanduser(os.environ.get(
        "IDEAFORGE_GOALS_DIR", "~/.local/state/north-star/goals")))
    cited = {}
    for path in sorted(root.glob("goal-*/goal.json")):
        goal = path.parent.name
        if not re.fullmatch(r"goal-[A-Za-z0-9-]+", goal):
            continue
        record = read_json_object(path)
        text = record.get("goal")
        if isinstance(text, str):
            for match in re.finditer(r"\bideaforge:(\d+)\b", text):
                cited.setdefault(int(match.group(1)), set()).add(goal)

    with db() as conn:
        conn.execute("BEGIN IMMEDIATE")
        idea_ids = {row[0] for row in conn.execute("SELECT id FROM ideas")}
        last_dismiss = {}
        for item, action, goal, at in conn.execute(
                "SELECT item, action, goal, at FROM decisions ORDER BY id"):
            match = re.fullmatch(r"idea:(\d+)", item)
            if not match:
                continue
            idea_id = int(match.group(1))
            if action == "send" and isinstance(goal, str) and re.fullmatch(r"goal-[A-Za-z0-9-]+", goal):
                cited.setdefault(idea_id, set()).add(goal)
            elif action in ("dismiss", "restore"):
                last_dismiss[idea_id] = (action, at)

        current = {row[0]: tuple(row[1:]) for row in conn.execute(
            "SELECT idea_id, result, goal, goal_status, evidence FROM factory_outcomes")}
        desired = {}
        for idea_id in idea_ids:
            matches = cited.get(idea_id)
            if matches:
                # Goal IDs begin with their UTC creation timestamp; tie-break by full ID.
                goal = max(matches)
                status = factory_goal_status(goal)
                result = ("shipped" if status == "MERGED" else "abandoned"
                          if status in ("PARKED", "SUPERSEDED", "FAILED", "REJECTED")
                          else "in_progress")
                desired[idea_id] = (result, goal, status, f"{goal} {status}", now_iso())
            elif last_dismiss.get(idea_id, (None,))[0] == "dismiss":
                at = last_dismiss[idea_id][1]
                desired[idea_id] = ("dismissed", None, None, f"dismissed {at}", at)
        for idea_id in current.keys() - desired.keys():
            conn.execute("DELETE FROM factory_outcomes WHERE idea_id=?", (idea_id,))
        for idea_id, row in desired.items():
            if current.get(idea_id) != row[:4]:
                conn.execute("""INSERT INTO factory_outcomes
                    (idea_id, result, goal, goal_status, evidence, at) VALUES (?, ?, ?, ?, ?, ?)
                    ON CONFLICT(idea_id) DO UPDATE SET result=excluded.result, goal=excluded.goal,
                    goal_status=excluded.goal_status, evidence=excluded.evidence, at=excluded.at""",
                    (idea_id, *row))


def factory_states(conn):
    states = {}
    for item, action, goal, status, error in conn.execute(
            "SELECT item, action, goal, status, error FROM decisions ORDER BY id"):
        state = states.setdefault(item, {})
        if action in ("dismiss", "restore"):
            state["dismissed"] = action == "dismiss"
        elif action in ("favourite", "unfavourite"):
            state["favourite"] = action == "favourite"
        elif action == "send":
            state.update(goal=goal, status=status, error=error)
    for state in states.values():
        if state.get("goal"):
            state["goal_status"] = factory_goal_status(state["goal"])
    return states


def factory_decision(item, action):
    """Persist the intent before HTTP; an interrupted/uncertain send is never auto-repeated."""
    if not isinstance(item, str) or ":" not in item or action not in ("send", "dismiss", "restore", "favourite", "unfavourite"):
        raise ValueError("Invalid item or action")
    kind, identifier = item.split(":", 1)
    with db() as conn:
        conn.row_factory = sqlite3.Row
        conn.execute("BEGIN IMMEDIATE")
        if kind == "idea" and identifier.isdecimal():
            row = conn.execute("SELECT * FROM ideas WHERE id=?", (int(identifier),)).fetchone()
            item = "idea:" + str(int(identifier))
        elif kind == "hub":
            row = conn.execute("SELECT * FROM hub_cards WHERE id=?", (identifier,)).fetchone()
        else:
            row = None
        if row is None:
            conn.rollback()
            raise ValueError("Item not found")
        if action != "send":
            conn.execute("INSERT INTO decisions(item, action, at) VALUES (?, ?, ?)", (item, action, now_iso()))
            conn.commit()
            return {"ok": True}
        previous = conn.execute("SELECT goal, status, error FROM decisions WHERE item=? AND action='send' "
                                "ORDER BY id DESC LIMIT 1", (item,)).fetchone()
        if previous and previous["status"] in ("accepted", "pending", "uncertain"):
            conn.commit()
            return {"ok": previous["status"] == "accepted", **dict(previous)}
        if kind == "idea":
            if row["eval_status"] != "done" or row["eval_verdict"] not in ("BUILD", "PARK", "SKIP"):
                conn.rollback()
                raise ValueError("Evaluate this idea before sending it to the factory")
            title, url = row["video_title"] or "Untitled idea", row["youtube_url"] or row["source_path"] or ""
            source = row["intake_source"] or "IdeaForge"
            summary = row["eval_one_sentence"] or row["nlm_summary"] or "Not available"
            verdict, score = row["eval_verdict"], row["eval_fit_score"]
        else:
            title, url, source, summary = (row[k] for k in ("title", "url", "source", "summary"))
            verdict, score = "not evaluated", "not available"
        text = (f"Harvested idea: {title}. Source: IdeaForge; found by: {source}. Link: {url}. "
                f"Summary: {summary}. Evaluation: {verdict}, fit {score}.")
        decision_id = conn.execute("INSERT INTO decisions(item, action, at, status, error) VALUES (?, 'send', ?, 'pending', ?)",
            (item, now_iso(), "Send pending; do not resend until its outcome is known")).lastrowid
        conn.commit()
    base = os.environ.get("IDEAFORGE_NORTH_STAR", "http://127.0.0.1:8789").rstrip("/")
    goal, error, status = None, None, "failed"
    try:
        request = urllib.request.Request(base + "/api/goals", data=json.dumps({"text": text}).encode(),
                                         headers={"Content-Type": "application/json"}, method="POST")
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRelayRedirect())
        with opener.open(request, timeout=130) as response:
            payload = response.read()
            if response.status == 202:
                status = "uncertain"
                data = json.loads(payload)
                goal = data.get("task") if isinstance(data, dict) else None
                if not isinstance(goal, str) or not re.fullmatch(r"goal-[A-Za-z0-9-]+", goal):
                    goal = None
                    raise ValueError("Accepted response has no valid goal id")
                status = "accepted"
            else:
                error = f"North Star HTTP {response.status}: " + payload.decode("utf-8", "replace")[:1000]
    except urllib.error.HTTPError as exc:
        error = f"North Star HTTP {exc.code}: " + exc.read().decode("utf-8", "replace")[:1000]
        exc.close()
    except (OSError, ValueError) as exc:
        status, error = "uncertain", f"North Star send outcome unknown: {exc}"
    with db() as conn:
        conn.execute("UPDATE decisions SET goal=?, status=?, error=? WHERE id=?", (goal, status, error, decision_id))
    return {"ok": status == "accepted", "goal": goal, "status": status, "error": error}

def valid_youtube_url(url: str) -> bool:
    try:
        u = urlparse(url)
        if u.scheme not in ("http", "https"):
            return False
        host = (u.netloc or "").lower()
        return ("youtube.com" in host) or ("youtu.be" in host)
    except Exception:
        return False

def detect_source_kind(input_str: str):
    """Detect source type from input. Returns (kind, value) tuple."""
    s = input_str.strip()
    if valid_youtube_url(s):
        return ("youtube", s)
    parsed = urlparse(s)
    if parsed.scheme == "https" and parsed.netloc.lower() in ("github.com", "www.github.com"):
        parts = parsed.path.strip("/").split("/")
        if len(parts) == 2 and all(re.fullmatch(r"[A-Za-z0-9_.-]+", part) for part in parts):
            return ("github_repo", "https://github.com/" + "/".join(parts).lower())
    if s.lower().endswith(".pdf") and os.path.isfile(s):
        return ("pdf", s)
    if s.startswith(("http://", "https://")) and ("rss" in s.lower() or "feed" in s.lower() or "atom" in s.lower() or s.endswith(".xml")):
        return ("rss", s)
    if s.startswith(("http://", "https://")):
        # Could be an RSS feed without obvious markers — try feedparser
        if RSS_AVAILABLE:
            try:
                f = feedparser.parse(s)
                if f.entries:
                    return ("rss", s)
            except Exception:
                pass
        return ("text", s)  # Unknown URL, treat as text
    if os.path.isfile(s):
        return ("text", s)
    # Raw text content
    return ("text", s)

class _HTMLStripper(HTMLParser):
    """Strip HTML tags, keep text."""
    def __init__(self):
        super().__init__()
        self._parts = []
    def handle_data(self, data):
        self._parts.append(data)
    def get_text(self):
        return " ".join(self._parts)

def strip_html(html_text: str) -> str:
    s = _HTMLStripper()
    s.feed(html_text)
    return s.get_text()

def run(cmd, timeout=180):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)

def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

