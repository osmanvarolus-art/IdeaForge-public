def _detect_nlm():
    configured = os.environ.get("IDEAFORGE_NLM_PATH")
    if configured:
        return configured, (os.path.isabs(configured) and os.path.isfile(configured)
                            and os.access(configured, os.X_OK))
    for name in ("notebooklm", "nlm"):
        p = shutil.which(name)
        if p:
            return p, True
    for fallback in ("~/.local/bin/notebooklm", "~/.local/bin/nlm"):
        p = os.path.expanduser(fallback)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p, True
    return "notebooklm", False

