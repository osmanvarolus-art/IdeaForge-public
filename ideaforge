            with db() as conn:
                cur = conn.execute("""
                    INSERT INTO notebooks (name, status, created_at, updated_at)
                    VALUES (?, 'pending', ?, ?)
                """, (name, ts, ts))
                notebook_id = cur.lastrowid
                for iid in idea_ids:
                    try:
                        conn.execute("INSERT INTO idea_notebooks (idea_id, notebook_id) VALUES (?, ?)",
