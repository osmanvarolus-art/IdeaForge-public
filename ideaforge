# ---------------- Notebook Integration ----------------

def nlm_run(args, timeout=120):
    """Run notebooklm CLI command. Returns (stdout, stderr, returncode)."""
    if not NLM_AVAILABLE:
        return "", "notebooklm CLI not installed. Run: pip install 'notebooklm-py[browser]'", -1
    try:
        env = {**os.environ, "NO_COLOR": "1"}
        result = subprocess.run([NLM_PATH] + args,
                                capture_output=True, text=True, timeout=timeout, env=env)
        return result.stdout, result.stderr, result.returncode
    except subprocess.TimeoutExpired:
        return "", f"Command timed out after {timeout}s", -2
    except Exception as e:
        return "", str(e), -1

def _nlm_json(stdout):
    try:
        data = json.loads(stdout)
        return data if isinstance(data, dict) else None
    except (json.JSONDecodeError, TypeError):
        return None

def _nlm_failed(idea_id, error):
    error = str(error).strip()[:500] or "NotebookLM command failed"
    with db() as conn:
        conn.execute("UPDATE ideas SET last_error=?, updated_at=? WHERE id=?",
                     (f"NotebookLM: {error}", now_iso(), idea_id))
        log_event(conn, idea_id, "nlm_ingest_failed", error)
    return {"ok": False, "error": error}

def _nlm_add_idea(idea_id, notebook_id, url, clean_path):
    with db() as conn:
        prior = conn.execute("SELECT detail FROM events WHERE idea_id=? AND kind='nlm_ingest_failed' "
                             "ORDER BY id DESC LIMIT 1", (idea_id,)).fetchone()
    if prior:
        return {"ok": False, "error": prior[0]}
    content = url or (clean_path if clean_path and os.path.exists(clean_path) else None)
    if not content:
        return _nlm_failed(idea_id, "No URL or transcript available")
    stdout, stderr, rc = nlm_run(["source", "add", "-n", notebook_id, content, "--json"], timeout=120)
    source = (_nlm_json(stdout) or {}).get("source")
    source_id = source.get("id") if isinstance(source, dict) else None
    if rc or not isinstance(source_id, str) or not source_id:
        return _nlm_failed(idea_id, f"Source add failed: {stderr or 'invalid JSON response'}")
    stdout, stderr, rc = nlm_run(["source", "wait", source_id, "-n", notebook_id,
                                  "--timeout", "600", "--json"], timeout=630)
    waited = _nlm_json(stdout)
    if rc or not waited or waited.get("status") != "ready":
        return _nlm_failed(idea_id, f"Source wait failed: {stderr or 'source not ready'}")
    stdout, stderr, rc = nlm_run(["source", "guide", source_id, "-n", notebook_id, "--json"], timeout=120)
    guide = _nlm_json(stdout)
    summary = guide.get("summary") if guide else None
    if rc or not isinstance(summary, str) or not summary.strip():
        return _nlm_failed(idea_id, f"Source guide failed: {stderr or 'empty summary'}")
    keywords = guide.get("keywords")
    if isinstance(keywords, list):
        words = [word.strip() for word in keywords if isinstance(word, str) and word.strip()]
    else:
        words = []
    summary = summary.strip() + ("\n\nKeywords: " + ", ".join(words) if words else "")
    with db() as conn:
        conn.execute("UPDATE ideas SET nlm_summary=?, updated_at=? WHERE id=?",
                     (summary, now_iso(), idea_id))
    return {"ok": True, "summary": summary}

def notebook_create_job(notebook_id: int) -> bool:
    """Create NotebookLM notebook and add sources."""
    with db() as conn:
        nb = conn.execute("SELECT name FROM notebooks WHERE id=?", (notebook_id,)).fetchone()
        if not nb:
            return False
        name = nb[0]
        conn.execute("UPDATE notebooks SET status='creating', updated_at=? WHERE id=?",
                     (now_iso(), notebook_id))

        # Get linked ideas — prefer YouTube URLs (NLM extracts its own transcript)
        rows = conn.execute("""
            SELECT i.id, i.video_title, i.youtube_url, i.transcript_clean_path
            FROM ideas i JOIN idea_notebooks inb ON i.id = inb.idea_id
            WHERE inb.notebook_id=? AND NOT EXISTS (
                SELECT 1 FROM events e WHERE e.idea_id=i.id AND e.kind='nlm_ingest_failed')
        """, (notebook_id,)).fetchall()

    if not rows:
        with db() as conn:
            conn.execute("UPDATE notebooks SET status='failed', error='No ideas linked', updated_at=? WHERE id=?",
                         (now_iso(), notebook_id))
        return False

    # Create notebook via CLI
    stdout, stderr, rc = nlm_run(["create", name, "--json"], timeout=60)
    if rc != 0:
        with db() as conn:
            conn.execute("UPDATE notebooks SET status='failed', error=?, updated_at=? WHERE id=?",
                         (f"Create failed: {stderr[:500]}", now_iso(), notebook_id))
        return False

    notebook = (_nlm_json(stdout) or {}).get("notebook")
    nlm_id = notebook.get("id") if isinstance(notebook, dict) else None
    with db() as conn:
        conn.execute("UPDATE notebooks SET nlm_id=?, updated_at=? WHERE id=?",
                     (nlm_id, now_iso(), notebook_id))

    if not isinstance(nlm_id, str) or not nlm_id:
        with db() as conn:
            conn.execute("UPDATE notebooks SET status='failed', error='Could not parse notebook ID from CLI output', updated_at=? WHERE id=?",
                         (now_iso(), notebook_id))
        return False

    # Add sources — prefer YouTube URL (NLM extracts transcript natively)
    added = 0
    for idea_id, title, youtube_url, clean_path in rows:
        result = _nlm_add_idea(idea_id, nlm_id, youtube_url, clean_path)
        if result["ok"]:
            added += 1
        else:
            print(f"Failed to add source for idea {idea_id}: {result['error'][:200]}")

    status = "ready" if added > 0 else "failed"
    error = None if added > 0 else "No sources could be added"
    with db() as conn:
        conn.execute("UPDATE notebooks SET status=?, error=?, source_count=?, updated_at=? WHERE id=?",
                     (status, error, added, now_iso(), notebook_id))
    return added > 0

def notebook_generate_job(notebook_id: int) -> bool:
    """Generate artifact (podcast/report/video/quiz/mind-map/slides) from notebook."""
    with db() as conn:
        nb = conn.execute("SELECT nlm_id, artifact_type FROM notebooks WHERE id=?",
                          (notebook_id,)).fetchone()
        if not nb or not nb[0]:
            conn.execute("UPDATE notebooks SET artifact_status='failed', error='No nlm_id', updated_at=? WHERE id=?",
                         (now_iso(), notebook_id))
            return False
        nlm_id, artifact_type = nb

        artifact_type = artifact_type or "audio"
        status_col = {"audio": "audio_status", "video": "video_status", "quiz": "quiz_status",
                      "mind-map": "mindmap_status", "slide-deck": "slides_status"}.get(artifact_type, "artifact_status")
        conn.execute(f"UPDATE notebooks SET {status_col}='generating', artifact_status='generating', updated_at=? WHERE id=?",
                     (now_iso(), notebook_id))

    gen_args = (["summary", "-n", nlm_id, "--json"] if artifact_type == "summary" else
                ["generate", artifact_type, "-n", nlm_id, "--wait", "--timeout", "600", "--json"])
    if artifact_type == "video":
        gen_args.extend(["--style", "whiteboard"])
    stdout, stderr, rc = nlm_run(gen_args, timeout=630)
    generated = _nlm_json(stdout)
    succeeded = (rc == 0 and generated is not None and not generated.get("error")
                 and generated.get("status") not in ("failed", "error"))

    # Try to download artifact
    dl_path = None
    if succeeded and artifact_type != "summary":
        dl_dir = os.path.join(DATA_DIR, "notebooks", str(notebook_id))
        os.makedirs(dl_dir, exist_ok=True)
        ext_map = {"audio": "m4a", "video": "mp4", "quiz": "md", "mind-map": "json",
                   "slide-deck": "pdf", "flashcards": "json", "infographic": "png", "data-table": "csv"}
        ext = ext_map.get(artifact_type, "bin")
        dl_path = os.path.join(dl_dir, f"{artifact_type}.{ext}")
        dl_out, dl_err, dl_rc = nlm_run(["download", artifact_type, dl_path, "-n", nlm_id, "--json"], timeout=300)
        if dl_rc != 0 or _nlm_json(dl_out) is None or not os.path.isfile(dl_path):
            dl_path = None  # download failed but generate succeeded

    status = "ready" if succeeded else "failed"
    error = None if succeeded else (stderr[:500] or "Invalid generation JSON")
    with db() as conn:
        conn.execute(f"UPDATE notebooks SET {status_col}=?, artifact_status=?, artifact_path=?, error=?, updated_at=? WHERE id=?",
                     (status, status, dl_path, error, now_iso(), notebook_id))
    return succeeded

def nlm_push_idea(idea_id: int, notebook_name: str = None, nlm_id: str = None) -> dict:
    """Push a single idea to NotebookLM. Creates notebook if needed."""
    with db() as conn:
        row = conn.execute("SELECT youtube_url, video_title, transcript_clean_path FROM ideas WHERE id=?",
                           (idea_id,)).fetchone()
        if not row:
            return {"ok": False, "error": "Idea not found"}
        url, title, clean_path = row
        prior = conn.execute("SELECT detail FROM events WHERE idea_id=? AND kind='nlm_ingest_failed' "
                             "ORDER BY id DESC LIMIT 1", (idea_id,)).fetchone()
        if prior:
            return {"ok": False, "error": prior[0]}

    # Create notebook if no nlm_id provided
    if not nlm_id:
        nb_name = notebook_name or title or f"IdeaForge-{idea_id}"
        stdout, stderr, rc = nlm_run(["create", nb_name, "--json"], timeout=60)
        if rc != 0:
            return _nlm_failed(idea_id, f"Create failed: {stderr[:300]}")
        notebook = (_nlm_json(stdout) or {}).get("notebook")
        nlm_id = notebook.get("id") if isinstance(notebook, dict) else None
        if not isinstance(nlm_id, str) or not nlm_id:
            return _nlm_failed(idea_id, "Could not parse notebook ID")

    result = _nlm_add_idea(idea_id, nlm_id, url, clean_path)
    return {**result, "nlm_id": nlm_id, "name": notebook_name or title}

def nlm_check_auth() -> dict:
    """Check NotebookLM auth status."""
    if not NLM_AVAILABLE:
        return {"installed": False, "authenticated": False, "error": "notebooklm CLI not found. Run: pip install 'notebooklm-py[browser]'"}
    stdout, stderr, rc = nlm_run(["auth", "check", "--json"], timeout=30)
    return {
        "installed": True,
        "authenticated": rc == 0,
        "output": (stdout + stderr).strip()[:500],
        "cli_path": NLM_PATH
    }

def nlm_list_notebooks() -> list:
    """List notebooks from NotebookLM account."""
    stdout, stderr, rc = nlm_run(["list", "--json"], timeout=30)
    if rc != 0:
        return []
    try:
        data = json.loads(stdout)
        if isinstance(data, list):
            return data
        if isinstance(data, dict):
            return data.get("notebooks", [data])
    except (json.JSONDecodeError, TypeError):
        pass
    return []

def nlm_chat(nlm_id: str, question: str) -> dict:
    """Ask a question to notebook sources."""
    stdout, stderr, rc = nlm_run(["query", "notebook", nlm_id, question], timeout=120)
    if rc != 0:
        return {"ok": False, "error": stderr[:500]}
    return {"ok": True, "answer": stdout.strip()}

def nlm_share(nlm_id: str, enable: bool = True) -> dict:
    """Toggle notebook sharing."""
    if enable:
        stdout, stderr, rc = nlm_run(["share", "public", nlm_id], timeout=30)
    else:
        stdout, stderr, rc = nlm_run(["share", "private", nlm_id], timeout=30)
    return {"ok": rc == 0, "output": (stdout + stderr).strip()[:500]}

def backfill_verdicts():
    """Backfill eval_verdict for existing evaluations missing verdict data."""
    threshold = build_threshold(compute_patterns())
    with db() as conn:
        rows = conn.execute("""
            SELECT id, evaluation_path FROM ideas
            WHERE eval_status='done' AND eval_verdict IS NULL AND evaluation_path IS NOT NULL
        """).fetchall()
        for idea_id, eval_path in rows:
            if not eval_path or not os.path.exists(eval_path):
                continue
            try:
                parsed = parse_evaluation(Path(eval_path).read_text(encoding="utf-8"))
                raw_verdict = parsed["build_recommendation"]["verdict"]
                fit_score = parsed.get("fit", {}).get("fit_score_0_100")
                verdict = evidence_verdict(raw_verdict, fit_score, parsed, threshold)
                complexity = parsed.get("fit", {}).get("complexity_1_5")
                one_sentence = parsed.get("top_idea", {}).get("one_sentence")
                conn.execute("""
                    UPDATE ideas SET eval_verdict=?, eval_raw_verdict=COALESCE(eval_raw_verdict, ?),
                        eval_fit_score=?, eval_complexity=?, eval_one_sentence=?
                    WHERE id=?
                """, (verdict, raw_verdict, fit_score, complexity, one_sentence, idea_id))
            except Exception:
                pass
        if rows:
            print(f"Backfilled verdicts for {len(rows)} ideas.")

def rescore(apply=False):
    """Re-score stored evidence offline; dry-run opens SQLite read-only, without migrations."""
    conn = sqlite3.connect(Path(DB_PATH).resolve().as_uri() + ('?mode=rw' if apply else '?mode=ro'),
                           uri=True, timeout=30)
    try:
        with conn:
            conn.execute('BEGIN IMMEDIATE' if apply else 'BEGIN')
            threshold = build_threshold(compute_patterns(conn))
            columns = {row[1] for row in conn.execute('PRAGMA table_info(ideas)')}
            raw_column = 'eval_raw_verdict' if 'eval_raw_verdict' in columns else 'NULL'
            rows = conn.execute(f"SELECT id,eval_verdict,{raw_column},eval_fit_score,evaluation_path "
                                "FROM ideas WHERE eval_verdict IS NOT NULL OR eval_status='done'").fetchall()
            changes, before, after = [], Counter(), Counter()
            unreadable = 0
            for idea_id, old, saved_raw, fit, path in rows:
                try:
                    parsed = parse_json_object(Path(path).read_text(encoding='utf-8'))
                    if not isinstance(parsed, dict):
                        raise ValueError('evaluation is not an object')
                except (OSError, ValueError, TypeError):
                    parsed = {}
                    unreadable += 1
                recommendation = parsed.get('build_recommendation')
                model_verdict = recommendation.get('verdict') if isinstance(recommendation, dict) else None
                if model_verdict not in ('BUILD', 'PARK', 'SKIP', 'REJECT'):
                    model_verdict = None
                raw = saved_raw or model_verdict or old
                verdict = evidence_verdict(raw, fit, parsed, threshold)
                before[old or 'UNKNOWN'] += 1
                after[verdict or 'UNKNOWN'] += 1
                changes.append((verdict, raw, idea_id))
            if apply:
                if 'eval_raw_verdict' not in columns:
                    conn.execute('ALTER TABLE ideas ADD COLUMN eval_raw_verdict TEXT')
                conn.executemany('UPDATE ideas SET eval_verdict=?, '
                                 'eval_raw_verdict=COALESCE(eval_raw_verdict, ?) WHERE id=?', changes)
        result = {'mode': 'apply' if apply else 'dry-run', 'threshold': threshold,
                  'evaluated': len(rows), 'before': dict(before), 'after': dict(after),
                  'unreadable_evaluations': unreadable}
        print(json.dumps(result, sort_keys=True))
        return result
    finally:
        conn.close()


def compute_patterns(connection=None):
    """Compute pattern intelligence from evaluated ideas."""
    with (db() if connection is None else nullcontext(connection)) as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute("""
            SELECT i.eval_verdict, i.eval_fit_score, i.eval_complexity,
                   COALESCE(i.outcome, f.result) AS outcome, i.created_at,
                   CASE WHEN i.outcome IS NOT NULL THEN 'owner'
                        WHEN f.result IS NOT NULL THEN 'factory' END AS outcome_source
            FROM ideas i LEFT JOIN factory_outcomes f ON f.idea_id=i.id
            WHERE i.eval_verdict IS NOT NULL
        """).fetchall()

    total_outcomes = sum(1 for r in rows if r["outcome"])
    owner_n = sum(1 for r in rows if r["outcome_source"] == "owner")
    factory_n = sum(1 for r in rows if r["outcome_source"] == "factory")
    if len(rows) < 10:
        return {"ready": False, "total_evaluated": len(rows), "minimum": 10,
                "total_outcomes": total_outcomes, "owner_n": owner_n, "factory_n": factory_n}

    # Verdict distribution
    verdicts = {"BUILD": 0, "SKIP": 0, "PARK": 0}
    fit_by_verdict = {"BUILD": [], "SKIP": [], "PARK": []}
    complexity_buckets = {1: {"total": 0, "shipped": 0}, 2: {"total": 0, "shipped": 0},
                          3: {"total": 0, "shipped": 0}, 4: {"total": 0, "shipped": 0},
                          5: {"total": 0, "shipped": 0}}
    weekly = {}  # iso-week -> count

    for r in rows:
        v = r["eval_verdict"]
        if v in verdicts:
            verdicts[v] += 1
        fit = r["eval_fit_score"]
        if v in fit_by_verdict and fit is not None:
            fit_by_verdict[v].append(fit)
        cplx = r["eval_complexity"]
        outcome = r["outcome"]
        if cplx and cplx in complexity_buckets:
            complexity_buckets[cplx]["total"] += 1
            if outcome == "shipped":
                complexity_buckets[cplx]["shipped"] += 1
        # Weekly trend
        ca = r["created_at"] or ""
        week_key = ca[:10]  # YYYY-MM-DD, group by week below
        if len(ca) >= 10:
            try:
                dt = datetime.fromisoformat(ca)
                week_key = f"{dt.isocalendar()[0]}-W{dt.isocalendar()[1]:02d}"
            except Exception:
                pass
        weekly[week_key] = weekly.get(week_key, 0) + 1

    total = sum(verdicts.values())
    avg_fit = {}
    for v in ("BUILD", "SKIP", "PARK"):
        fits = fit_by_verdict[v]
        avg_fit[v] = round(sum(fits) / len(fits), 1) if fits else None

    # Ship rate by complexity
    complexity_rates = {}
    for c in range(1, 6):
        b = complexity_buckets[c]
        complexity_rates[str(c)] = {
            "total": b["total"],
            "shipped": b["shipped"],
            "rate": round(b["shipped"] / b["total"], 3) if b["total"] > 0 else None
        }

    # Effective build threshold
    shipped_fits = [r["eval_fit_score"] for r in rows if r["outcome"] == "shipped" and r["eval_fit_score"] is not None]
    not_shipped_fits = [r["eval_fit_score"] for r in rows if r["outcome"] and r["outcome"] != "shipped" and r["eval_fit_score"] is not None]
    effective_threshold = None
    if shipped_fits and not_shipped_fits:
        effective_threshold = round((sum(shipped_fits) / len(shipped_fits) + sum(not_shipped_fits) / len(not_shipped_fits)) / 2, 1)

    # Ship rate for BUILD ideas
    build_with_outcome = [r for r in rows if r["eval_verdict"] == "BUILD" and r["outcome"]]
    build_ship_rate = None
    if build_with_outcome:
        build_ship_rate = round(sum(1 for r in build_with_outcome if r["outcome"] == "shipped") / len(build_with_outcome), 3)

    # Sort weekly trend
    sorted_weeks = sorted(weekly.items())[-12:]  # last 12 weeks

    # Count total outcomes
    return {
        "ready": True,
        "total_evaluated": total,
        "total_outcomes": total_outcomes,
        "owner_n": owner_n,
        "factory_n": factory_n,
        "verdicts": verdicts,
        "avg_fit_by_verdict": avg_fit,
        "complexity_rates": complexity_rates,
        "effective_threshold": effective_threshold,
        "build_ship_rate": build_ship_rate,
        "weekly_trend": [{"week": w, "count": c} for w, c in sorted_weeks],
    }

OUTCOME_COHORT_SQL = """(i.outcome IS NOT NULL OR f.result IS NOT NULL OR
    EXISTS (SELECT 1 FROM decisions d WHERE d.item='idea:' || i.id
            AND d.action='send' AND COALESCE(d.goal, '') != '') OR
    (SELECT d.action FROM decisions d WHERE d.item='idea:' || i.id
     AND d.action IN ('favourite','unfavourite') ORDER BY d.id DESC LIMIT 1)='favourite')"""


def outcome_counts(conn):
    rows = conn.execute(f"""SELECT i.eval_verdict, i.outcome, f.result,
        COALESCE({OUTCOME_COHORT_SQL}, 0) FROM ideas i
        LEFT JOIN factory_outcomes f ON f.idea_id=i.id""").fetchall()
    return {
        'total_eligible': sum(bool(eligible) for _, _, _, eligible in rows),
        'owner_outcomes': sum(owner is not None for _, owner, _, _ in rows),
        'factory_outcomes': sum(factory is not None for _, _, factory, _ in rows),
        'combined_outcomes': sum(owner is not None or factory is not None for _, owner, factory, _ in rows),
        'build_waiting': sum(verdict == 'BUILD' and not eligible for verdict, _, _, eligible in rows),
    }


def compute_calibration():
    """Compute calibration stats from ideas with outcomes. Insert snapshot into calibration_log."""
    with db() as conn:
        evidence = conn.execute("""
            SELECT i.eval_verdict, i.eval_fit_score, i.outcome, f.result
            FROM ideas i LEFT JOIN factory_outcomes f ON f.idea_id=i.id
            WHERE i.eval_verdict IS NOT NULL AND (i.outcome IS NOT NULL OR f.result IS NOT NULL)
        """).fetchall()
        rows = [(verdict, fit, owner if owner is not None else factory)
                for verdict, fit, owner, factory in evidence]
        counts = outcome_counts(conn)
        if not rows:
            return {**counts, 'total_with_outcome': 0, 'owner_n': 0, 'factory_n': 0}

        owner_n = sum(owner is not None for _, _, owner, _ in evidence)
        factory_n = len(rows) - owner_n

        by_verdict = {"BUILD": [], "SKIP": [], "PARK": []}
        for verdict, fit, outcome in rows:
            if verdict in by_verdict:
                by_verdict[verdict].append((fit, outcome))

        def ship_rate(items):
            if not items:
                return None
            shipped = sum(1 for _, o in items if o == "shipped")
            return round(shipped / len(items), 3) if items else None

        shipped_fits = [fit for _, fit, outcome in rows if outcome == "shipped" and fit is not None]
        not_shipped_fits = [fit for _, fit, outcome in rows if outcome != "shipped" and fit is not None]

        avg_fit_shipped = round(sum(shipped_fits) / len(shipped_fits), 1) if shipped_fits else None
        avg_fit_not_shipped = round(sum(not_shipped_fits) / len(not_shipped_fits), 1) if not_shipped_fits else None

        # Effective threshold: midpoint between avg shipped and not-shipped fit scores
        effective_threshold = None
        if avg_fit_shipped is not None and avg_fit_not_shipped is not None:
            effective_threshold = round((avg_fit_shipped + avg_fit_not_shipped) / 2, 1)

        snapshot = {
            **counts,
            "total_with_outcome": len(rows),
            "owner_n": owner_n,
            "factory_n": factory_n,
            "build_count": len(by_verdict["BUILD"]),
            "skip_count": len(by_verdict["SKIP"]),
            "park_count": len(by_verdict["PARK"]),
            "build_ship_rate": ship_rate(by_verdict["BUILD"]),
            "skip_ship_rate": ship_rate(by_verdict["SKIP"]),
            "park_ship_rate": ship_rate(by_verdict["PARK"]),
            "avg_fit_shipped": avg_fit_shipped,
            "avg_fit_not_shipped": avg_fit_not_shipped,
            "effective_threshold": effective_threshold,
        }

        conn.execute("""
            INSERT INTO calibration_log
            (snapshot_at, total_with_outcome, owner_n, factory_n, build_count, skip_count, park_count,
             build_ship_rate, skip_ship_rate, park_ship_rate,
             avg_fit_shipped, avg_fit_not_shipped, effective_threshold)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (now_iso(), snapshot["total_with_outcome"],
              snapshot["owner_n"], snapshot["factory_n"],
              snapshot["build_count"], snapshot["skip_count"], snapshot["park_count"],
              snapshot["build_ship_rate"], snapshot["skip_ship_rate"], snapshot["park_ship_rate"],
              snapshot["avg_fit_shipped"], snapshot["avg_fit_not_shipped"], snapshot["effective_threshold"]))
        return snapshot

