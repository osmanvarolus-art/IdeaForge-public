def fetch_channel_recent(channel_url: str, max_results: int = 5) -> list:
    """Fetch recent videos from a YouTube channel via yt-dlp."""
    try:
        result = run(["yt-dlp", "--flat-playlist", "--print-json",
                       "--playlist-end", str(max_results), channel_url], timeout=60)
        videos = []
        for line in result.stdout.strip().split('\n'):
            if not line.strip():
                continue
            try:
                data = json.loads(line)
                vid_id = data.get("id", "")
                url = data.get("url") or data.get("webpage_url") or f"https://www.youtube.com/watch?v={vid_id}"
                if not url.startswith("http"):
                    url = f"https://www.youtube.com/watch?v={vid_id}"
                videos.append({
                    "url": url,
                    "title": data.get("title", ""),
                    "id": vid_id,
                })
            except (json.JSONDecodeError, TypeError):
                continue
        return videos
    except Exception as e:
        print(f"fetch_channel_recent error: {e}")
        return []


class _TrendingParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.repos = []
        self.repo = None
        self.heading = False
        self.field = None

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "article" and "Box-row" in attrs.get("class", "").split():
            self.repo = {"description": "", "language": None, "total_stars": None,
                         "sponsors_link": False}
            self.text = []
        if self.repo is None:
            return
        if tag == "h2":
            self.heading = True
        if self.heading and tag == "a":
            path = attrs.get("href", "")
            if re.fullmatch(r"/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", path):
                self.repo["name"] = path.strip("/")
                self.repo["url"] = "https://github.com" + path
        if tag == "a" and attrs.get("href", "").startswith("/sponsors/"):
            self.repo["sponsors_link"] = True
        if tag == "p" and "col-9" in attrs.get("class", "").split():
            self.field, self.parts = "description", []
        elif tag == "span" and attrs.get("itemprop") == "programmingLanguage":
            self.field, self.parts = "language", []
        elif tag == "a" and attrs.get("href", "").endswith("/stargazers"):
            self.field, self.parts = "total_stars", []

    def handle_data(self, data):
        if self.repo is not None:
            self.text.append(data)
            if self.field:
                self.parts.append(data)

    def handle_endtag(self, tag):
        if self.repo is None:
            return
        if self.field and tag == {"description": "p", "language": "span",
                                 "total_stars": "a"}[self.field]:
            value = " ".join(" ".join(self.parts).split())
            self.repo[self.field] = (int(value.replace(",", "")) if self.field == "total_stars"
                                     and re.fullmatch(r"[\d,]+", value) else value)
            self.field = None
        if tag == "h2":
            self.heading = False
        if tag == "article":
            match = re.search(r"([\d,]+) stars (today|this week)\b", " ".join(self.text))
            if (self.repo.get("name") and match
                    and isinstance(self.repo["total_stars"], int)):
                self.repo["description"] = self.repo["description"] or "not visible"
                self.repo["stars_period"] = match.group(2)
                self.repo["stars_gained"] = int(match.group(1).replace(",", ""))
                if match.group(2) == "today":
                    self.repo["stars_today"] = self.repo["stars_gained"]
                self.repos.append(self.repo)
            self.repo = None


def parse_github_trending(html_text: str) -> list:
    parser = _TrendingParser()
    parser.feed(html_text)
    return list({repo["url"].lower(): repo for repo in parser.repos}.values())


def fetch_github_trending(target: str) -> list:
    if target not in ("daily", "weekly"):
        raise ValueError("GitHub trending target must be daily or weekly")
    request = urllib.request.Request("https://github.com/trending?since=" + target,
                                     headers={"User-Agent": "IdeaForge/1.0"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return parse_github_trending(response.read().decode("utf-8"))


def github_repo_text(repo: dict) -> str:
    return (f"Repository: {repo['name']}\nURL: {repo['url']}\n"
            f"Description: {repo.get('description') or 'not visible'}\n"
            f"Language: {repo.get('language') or 'not visible'}\n"
            f"Stars {repo['stars_period']}: {repo['stars_gained']}\n"
            f"Total stars: {repo['total_stars']}\n"
            f"GitHub Sponsors link: {'visible' if repo.get('sponsors_link') else 'not visible'}\n"
            "Open issues: not visible\nRevenue or pricing: not visible\n"
            "Trigger for trend: not visible")


def extract_github_repo_job(idea_id: int) -> bool:
    with db() as conn:
        row = conn.execute("SELECT transcript_preview, source_path FROM ideas WHERE id=?",
                           (idea_id,)).fetchone()
    if not row:
        return False
    content = row[0] or f"Repository: {row[1]}\nProduct evidence: not visible"
    path = os.path.join(idea_dir(idea_id), "repo.txt")
    with open(path, "w", encoding="utf-8") as stream:
        stream.write(content)
    with db() as conn:
        conn.execute("""UPDATE ideas SET transcript_clean_path=?, extract_status='done',
            instr_status='disabled', updated_at=? WHERE id=?""", (path, now_iso(), idea_id))
        log_event(conn, idea_id, "extract:done", "github_repo")
    return True

def radar_scan_subscription(sub_id: int):
    """Scan a single subscription for new content."""
    with db() as conn:
        conn.row_factory = sqlite3.Row
        sub = conn.execute("SELECT * FROM subscriptions WHERE id=?", (sub_id,)).fetchone()
        if not sub:
            return

    kind = sub["kind"]
    target = sub["target"]
    max_items = sub["max_items"] or 5
    auto_eval = bool(sub["auto_evaluate"])
    new_count = 0
    detail_parts = []

    try:
        if kind == "github_trending":
            for repo in fetch_github_trending(target)[:max_items]:
                _, added = ingest_idea(repo["url"], "github_repo", title=repo["name"],
                    source="github_trending", content=github_repo_text(repo),
                    chain=["evaluate"] if auto_eval else [])
                if added:
                    new_count += 1
                    detail_parts.append(repo["name"])

        elif kind == "youtube_channel":
            videos = fetch_channel_recent(target, max_items)
            for v in videos:
                with db() as conn:
                    existing = conn.execute("SELECT id FROM ideas WHERE youtube_url=?", (v["url"],)).fetchone()
                    if existing:
                        continue
                    ts = now_iso()
                    cur = conn.execute("""
                        INSERT INTO ideas (youtube_url, source_kind, extract_status, eval_status, instr_status, created_at, updated_at)
                        VALUES (?, 'youtube', 'pending', 'pending', 'pending', ?, ?)
                    """, (v["url"], ts, ts))
                    idea_id = cur.lastrowid
                    log_event(conn, idea_id, "radar:ingest", f"sub:{sub_id} channel:{target}")
                chain = ["evaluate", "instruct"] if auto_eval else []
                JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": v["url"], "source_kind": "youtube", "chain": chain})
                new_count += 1
                detail_parts.append(v.get("title", v["url"])[:60])

        elif kind == "youtube_search":
            results = youtube_search(target, max_items)
            for r in results:
                with db() as conn:
                    existing = conn.execute("SELECT id FROM ideas WHERE youtube_url=?", (r["url"],)).fetchone()
                    if existing:
                        continue
                    ts = now_iso()
                    cur = conn.execute("""
                        INSERT INTO ideas (youtube_url, source_kind, extract_status, eval_status, instr_status, created_at, updated_at)
                        VALUES (?, 'youtube', 'pending', 'pending', 'pending', ?, ?)
                    """, (r["url"], ts, ts))
                    idea_id = cur.lastrowid
                    log_event(conn, idea_id, "radar:ingest", f"sub:{sub_id} search:{target}")
                chain = ["evaluate", "instruct"] if auto_eval else []
                JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": r["url"], "source_kind": "youtube", "chain": chain})
                new_count += 1
                detail_parts.append(r.get("title", r["url"])[:60])

        elif kind == "rss_feed":
            source_kind, source_val = detect_source_kind(target)
            if source_kind == "rss":
                with db() as conn:
                    existing = conn.execute("SELECT id FROM ideas WHERE youtube_url=?", (target,)).fetchone()
                    if not existing:
                        ts = now_iso()
                        cur = conn.execute("""
                            INSERT INTO ideas (youtube_url, source_kind, source_path, extract_status, eval_status, instr_status, created_at, updated_at)
                            VALUES (?, 'rss', ?, 'pending', 'pending', 'pending', ?, ?)
                        """, (target, target, ts, ts))
                        idea_id = cur.lastrowid
                        log_event(conn, idea_id, "radar:ingest", f"sub:{sub_id} rss:{target}")
                        chain = ["evaluate", "instruct"] if auto_eval else []
                        JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": target, "source_kind": "rss", "chain": chain})
                        new_count += 1
                        detail_parts.append(target[:60])

        elif kind == "research_brief":
            # target = research_briefs.id
            brief_id = int(target)
            with db() as conn:
                conn.row_factory = sqlite3.Row
                brief = conn.execute("SELECT * FROM research_briefs WHERE id=?", (brief_id,)).fetchone()
            if brief:
                ts = now_iso()
                with db() as conn:
                    cur = conn.execute("""
                        INSERT INTO research_runs (mode, prompt, brief_id, status, created_at, updated_at)
                        VALUES ('youtube', ?, ?, 'pending', ?, ?)
                    """, (brief["prompt"], brief_id, ts, ts))
                    run_id = cur.lastrowid
                    conn.execute("UPDATE research_briefs SET total_runs=total_runs+1, updated_at=? WHERE id=?",
                                 (ts, brief_id))
                JOBQ.put({"kind": "research_run", "idea_id": 0, "run_id": run_id})
                detail_parts.append(f"research run {run_id} queued")
                new_count = 1  # Signal that something happened

        status = "ok"
    except Exception as e:
        status = "error"
        detail_parts.append(str(e)[:200])

    # Log run
    with db() as conn:
        conn.execute("""
            INSERT INTO subscription_runs (sub_id, run_at, new_ideas, status, detail)
            VALUES (?, ?, ?, ?, ?)
        """, (sub_id, now_iso(), new_count, status, "; ".join(detail_parts)[:2000]))
        conn.execute("UPDATE subscriptions SET last_run_at=?, updated_at=? WHERE id=?",
                     (now_iso(), now_iso(), sub_id))

    # Telegram digest if new BUILD verdicts found
    if new_count > 0 and TELEGRAM_TOKEN:
        send_telegram_digest(f"Radar: {new_count} new idea(s) from '{sub['name']}' subscription.")

    print(f"Radar scan sub:{sub_id} ({sub['name']}): {new_count} new ideas")

def scan_due_subscriptions():
    """Check all subscriptions and scan those that are due."""
    with db() as conn:
        conn.row_factory = sqlite3.Row
        subs = conn.execute("SELECT * FROM subscriptions WHERE enabled=1").fetchall()

    for sub in subs:
        last_run = sub["last_run_at"]
        freq_h = sub["frequency_hours"] or 24
        if last_run:
            from datetime import datetime, timezone
            try:
                lr = datetime.fromisoformat(last_run)
                elapsed_h = (datetime.now(timezone.utc).astimezone() - lr).total_seconds() / 3600
                if elapsed_h < freq_h:
                    continue
            except Exception:
                pass
        JOBQ.put({"kind": "radar_scan", "idea_id": 0, "sub_id": sub["id"]})

def radar_loop():
    """Background daemon thread: scan due subscriptions periodically."""
    while not STOP.is_set():
        STOP.wait(3600)  # Check every hour
        if STOP.is_set():
            break
        try:
            JOBQ.put({"kind": "hub_sync", "idea_id": 0})
            scan_due_subscriptions()
        except Exception as e:
            print(f"Radar loop error: {e}")

