def card_markdown(row, kind):
    if kind == "idea":
        details = idea_details(row)
        title, link = row.get("video_title"), row.get("youtube_url") or row.get("source_path")
        verdict = row.get("eval_verdict") or "Not evaluated"
        summary = row.get("nlm_summary") or details["core"] or "Not available"
    else:
