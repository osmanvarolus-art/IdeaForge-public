        if self.path.startswith("/api/research/brief/") and self.path.endswith("/radar"):
            try:
                brief_id = int(self.path.split("/")[4])
            except (ValueError, IndexError):
                self._json({"ok": False, "error": "invalid brief id"}, 400); return
            freq = body.get("frequency_hours", 24)
            with db() as conn:
                conn.row_factory = sqlite3.Row
                brief = conn.execute("SELECT * FROM research_briefs WHERE id=?", (brief_id,)).fetchone()
                if not brief:
                    self._json({"ok": False, "error": "brief not found"}, 404); return
                if brief["radar_sub_id"]:
                    self._json({"ok": False, "error": "already linked to radar subscription " + str(brief["radar_sub_id"])}, 400)
                    return
                ts = now_iso()
                cur = conn.execute("""
                    INSERT INTO subscriptions (name, kind, target, frequency_hours, max_items, auto_evaluate, enabled, created_at, updated_at)
                    VALUES (?, 'research_brief', ?, ?, 50, 1, 1, ?, ?)
                """, (brief["name"], str(brief_id), int(freq), ts, ts))
                sub_id = cur.lastrowid
                conn.execute("UPDATE research_briefs SET radar_sub_id=?, updated_at=? WHERE id=?",
                             (sub_id, ts, brief_id))
            self._json({"ok": True, "subscription_id": sub_id, "brief_id": brief_id})
            return

        # --- Brain Query ---
        if self.path == "/api/brain/query":
            question = (body.get("question") or "").strip()
            if not question:
                self._json({"ok": False, "error": "question required"}, 400); return
            complexity = body.get("complexity_estimate")
            if complexity is not None:
                try:
                    complexity = int(complexity)
                except (ValueError, TypeError):
                    complexity = None

            # Quick pattern-match verdict (no LLM)
            result = brain_should_build(question, body.get("description", ""), body.get("source_type", "youtube"), complexity)

            # If confidence is low and AI backend available, enhance with LLM reasoning
            if result["confidence"] < 0.5 and ai_backend:
                brain_path = os.path.join(DATA_DIR, "brain", "brain-latest.json")
                brain_ctx = ""
                if os.path.exists(brain_path):
                    try:
                        brain_ctx = json.dumps(json.load(open(brain_path, "r")), indent=1)[:3000]
                    except Exception:
                        pass
                llm_prompt = f"""You are IdeaForge's brain — a calibrated decision engine for a solo developer.

BRAIN STATE:
{brain_ctx}

QUESTION: Should this developer build: "{question}"
{f'Description: {body.get("description", "")[:300]}' if body.get("description") else ''}
{f'Estimated complexity: {complexity}/5' if complexity else ''}

Based on the brain state (patterns, calibration, ship rates, verdict anchors), give:
1. verdict: BUILD, PARK, or SKIP
2. confidence: 0.0-1.0
3. reason: 1-2 sentences explaining why
4. estimated_fit: 0-100 score estimate

Reply ONLY with valid JSON: {{"verdict":"...","confidence":0.0,"reason":"...","estimated_fit":0}}"""
                try:
                    llm_resp, _, _ = llm_call(llm_prompt, max_tokens=300, temperature=0.3)
                    llm_json = parse_json_object(llm_resp)
                    result["verdict"] = llm_json.get("verdict", result["verdict"])
                    result["confidence"] = llm_json.get("confidence", result["confidence"])
                    result["reason"] = llm_json.get("reason", result["reason"])
                    if llm_json.get("estimated_fit"):
                        result["estimated_fit"] = llm_json["estimated_fit"]
                    result["source"] = "llm_enhanced"
                except Exception:
                    result["source"] = "pattern_match"
            else:
                result["source"] = "pattern_match"

            self._json({"ok": True, **result})
            return

        # --- NLM: Push idea directly ---
        if self.path == "/api/nlm/push":
            idea_id = body.get("idea_id")
            notebook_name = body.get("notebook_name", "").strip()
            nlm_id = body.get("nlm_id", "").strip()
            if not idea_id:
                self._json({"ok": False, "error": "idea_id required"}, 400); return
            if not NLM_AVAILABLE:
                self._json({"ok": False, "error": "notebooklm CLI not installed. Run: pip install 'notebooklm-py[browser]'"}, 503); return
            result = nlm_push_idea(int(idea_id), notebook_name or None, nlm_id or None)
            if result.get("ok") and result.get("nlm_id"):
                ts = now_iso()
                with db() as conn:
                    cur = conn.execute("""
                        INSERT INTO notebooks (name, nlm_id, status, source_count, created_at, updated_at)
                        VALUES (?, ?, 'ready', 1, ?, ?)
                    """, (result.get("name", "Pushed Notebook"), result["nlm_id"], ts, ts))
                    nb_id = cur.lastrowid
                    try:
                        conn.execute("INSERT INTO idea_notebooks (idea_id, notebook_id) VALUES (?, ?)",
                                     (int(idea_id), nb_id))
                    except Exception:
                        pass
            self._json(result)
            return

        # --- NLM: Generate content ---
        if self.path == "/api/nlm/generate":
            nlm_id = (body.get("nlm_id") or "").strip()
            gen_type = body.get("type", "audio")
            if not nlm_id:
                self._json({"ok": False, "error": "nlm_id required"}, 400); return
            if not NLM_AVAILABLE:
                self._json({"ok": False, "error": "notebooklm CLI not installed"}, 503); return
            with db() as conn:
                nb = conn.execute("SELECT id FROM notebooks WHERE nlm_id=?", (nlm_id,)).fetchone()
                if nb:
                    notebook_id = nb[0]
                    conn.execute("UPDATE notebooks SET artifact_type=?, artifact_status='queued', updated_at=? WHERE id=?",
                                 (gen_type, now_iso(), notebook_id))
                else:
                    ts = now_iso()
                    cur = conn.execute("INSERT INTO notebooks (name, nlm_id, status, artifact_type, artifact_status, created_at, updated_at) VALUES (?, ?, 'ready', ?, 'queued', ?, ?)",
                                       (f"NLM-{nlm_id[:8]}", nlm_id, gen_type, ts, ts))
                    notebook_id = cur.lastrowid
            JOBQ.put({"kind": "notebook_generate", "notebook_id": notebook_id, "idea_id": 0})
            self._json({"ok": True, "notebook_id": notebook_id, "status": f"generating {gen_type}"})
            return

        # --- NLM: Chat with sources ---
        if self.path == "/api/nlm/chat":
            nlm_id = (body.get("nlm_id") or "").strip()
            question = (body.get("question") or "").strip()
            if not nlm_id or not question:
                self._json({"ok": False, "error": "nlm_id and question required"}, 400); return
            if not NLM_AVAILABLE:
                self._json({"ok": False, "error": "notebooklm CLI not installed"}, 503); return
            result = nlm_chat(nlm_id, question)
            self._json(result)
            return

        # --- NLM: Share ---
        if self.path == "/api/nlm/share":
            nlm_id = (body.get("nlm_id") or "").strip()
            if not nlm_id:
                self._json({"ok": False, "error": "nlm_id required"}, 400); return
            if not NLM_AVAILABLE:
                self._json({"ok": False, "error": "notebooklm CLI not installed"}, 503); return
            result = nlm_share(nlm_id, body.get("enable", True))
            self._json(result)
            return

        self._json({"ok": False, "error": "not found"}, 404)

    def do_DELETE(self):
        if self.path.startswith("/api/ideas/"):
            idea_id = int(self.path.split("/")[-1])
            # purge files too
            d = os.path.join(DATA_DIR, str(idea_id))
            try:
                if os.path.isdir(d):
                    shutil.rmtree(d)
            except Exception:
                pass
            with db() as conn:
                conn.execute("DELETE FROM ideas WHERE id=?", (idea_id,))
            self._json({"ok": True, "deleted": idea_id})
            return

        if self.path.startswith("/api/subscription/"):
            try:
                sub_id = int(self.path.split("/")[-1])
            except ValueError:
                self._json({"ok": False, "error": "invalid id"}, 400); return
            with db() as conn:
                conn.execute("DELETE FROM subscription_runs WHERE sub_id=?", (sub_id,))
                conn.execute("DELETE FROM subscriptions WHERE id=?", (sub_id,))
            self._json({"ok": True, "deleted": sub_id})
            return

        if self.path.startswith("/api/notebook/"):
            try:
                notebook_id = int(self.path.split("/")[-1])
            except ValueError:
                self._json({"ok": False, "error": "invalid id"}, 400); return
            with db() as conn:
                conn.execute("DELETE FROM idea_notebooks WHERE notebook_id=?", (notebook_id,))
                conn.execute("DELETE FROM notebooks WHERE id=?", (notebook_id,))
            self._json({"ok": True, "deleted": notebook_id})
            return

        self._json({"ok": False, "error": "not found"}, 404)

class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    allow_reuse_address = True
    daemon_threads = True

def main():
    ensure_dirs()
    init_db()
    backfill_verdicts()
    refresh_factory_outcomes()
    compute_calibration()
    load_pending_jobs()
    threading.Thread(target=worker_loop, daemon=True).start()
    threading.Thread(target=radar_loop, daemon=True).start()
    print(f"IdeaForge v1 running at http://{HOST}:{PORT} (AI={ai_backend or 'OFF'}) model={MODEL}")
    srv = ThreadedHTTPServer((HOST, PORT), Handler)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        STOP.set()
        srv.shutdown()

if __name__ == "__main__":
    import sys
    if len(sys.argv) > 1 and sys.argv[1] == 'rescore':
        import argparse
        parser = argparse.ArgumentParser(description='Re-score stored evaluations without a model call.')
        mode = parser.add_mutually_exclusive_group(required=True)
        mode.add_argument('--dry-run', action='store_true')
        mode.add_argument('--apply', action='store_true')
        parser.add_argument('--db', default=DB_PATH, help='SQLite database (default: IdeaForge database)')
        args = parser.parse_args(sys.argv[2:])
        DB_PATH = args.db
        rescore(apply=args.apply)
    else:
        main()
