                    SELECT s.*, (SELECT COUNT(*) FROM subscription_runs sr WHERE sr.sub_id=s.id) as run_count,
                           (SELECT sr.run_at FROM subscription_runs sr WHERE sr.sub_id=s.id ORDER BY sr.id DESC LIMIT 1) as latest_run_at,
                           (SELECT sr.new_ideas FROM subscription_runs sr WHERE sr.sub_id=s.id ORDER BY sr.id DESC LIMIT 1) as latest_new_ideas
                    FROM subscriptions s ORDER BY s.created_at DESC
                """).fetchall()
