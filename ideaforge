        if self.path == "/api/pipeline":
            urls = body.get("urls", [])
            notebook_name = (body.get("notebook_name") or "").strip()
            if not urls or not isinstance(urls, list):
                self._json({"ok": False, "error": "urls required"}, 400); return
            if not notebook_name:
                notebook_name = f"Pipeline {now_iso()[:10]}"
            ts = now_iso()
            idea_ids = []
            for url in urls:
                url = (url or "").strip()
                if not valid_youtube_url(url):
                    continue
                with db() as conn:
                    cur = conn.execute("""
                        INSERT INTO ideas (youtube_url, extract_status, eval_status, instr_status, created_at, updated_at)
                        VALUES (?, 'pending', 'pending', 'pending', ?, ?)
                    """, (url, ts, ts))
                    idea_id = cur.lastrowid
                    log_event(conn, idea_id, "pipeline:ingest", url)
                JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": url, "chain": ["evaluate", "instruct"]})
                idea_ids.append(idea_id)
            notebook_id = None
            if idea_ids:
                with db() as conn:
                    cur = conn.execute("""
                        INSERT INTO notebooks (name, status, created_at, updated_at)
                        VALUES (?, 'waiting', ?, ?)
                    """, (notebook_name, ts, ts))
                    notebook_id = cur.lastrowid
                    for iid in idea_ids:
                        conn.execute("INSERT INTO idea_notebooks (idea_id, notebook_id) VALUES (?, ?)", (iid, notebook_id))
            self._json({"ok": True, "idea_ids": idea_ids, "notebook_id": notebook_id, "status": "pipeline started"})
            return

        if self.path.startswith("/api/notebook/") and self.path.endswith("/finalize"):
            parts = self.path.split("/")
            try:
                notebook_id = int(parts[3])
            except (ValueError, IndexError):
                self._json({"ok": False, "error": "invalid id"}, 400); return
            if not NLM_AVAILABLE:
                self._json({"ok": False, "error": "nlm CLI not available"}, 503); return
            with db() as conn:
                nb = conn.execute("SELECT status FROM notebooks WHERE id=?", (notebook_id,)).fetchone()
                if not nb:
                    self._json({"ok": False, "error": "not found"}, 404); return
                if nb[0] not in ("waiting", "pending", "failed"):
                    self._json({"ok": False, "error": f"notebook already {nb[0]}"}, 400); return
                conn.execute("UPDATE notebooks SET status='pending', updated_at=? WHERE id=?",
                             (now_iso(), notebook_id))
            JOBQ.put({"kind": "notebook_create", "notebook_id": notebook_id})
            self._json({"ok": True, "id": notebook_id, "status": "creating notebook"})
            return

        if self.path.startswith("/api/notebook/") and self.path.endswith("/generate"):
            parts = self.path.split("/")
            try:
                notebook_id = int(parts[3])
            except (ValueError, IndexError):
                self._json({"ok": False, "error": "invalid id"}, 400); return
            artifact_type = body.get("type", "podcast")
            if not NLM_AVAILABLE:
                self._json({"ok": False, "error": "nlm CLI not available"}, 503); return
            with db() as conn:
                conn.execute("""
                    UPDATE notebooks SET artifact_type=?, artifact_status='queued', updated_at=?
                    WHERE id=?
                """, (artifact_type, now_iso(), notebook_id))
            JOBQ.put({"kind": "notebook_generate", "notebook_id": notebook_id, "idea_id": 0})
