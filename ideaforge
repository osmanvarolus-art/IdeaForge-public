def brain_should_build(title: str, description: str = "", source_type: str = "youtube", complexity_estimate: int = None) -> dict:
    """Quick BUILD/PARK/SKIP prediction from pattern matching — no LLM call needed for obvious cases."""
    patterns = compute_patterns()
    if not patterns.get("ready"):
        return {"verdict": None, "confidence": 0.0, "reason": "Not enough data yet. Evaluate more ideas to train the brain."}

    # Get thresholds
    effective_threshold = patterns.get("effective_threshold")
    complexity_thresholds = compute_per_complexity_thresholds()
    domain_thresholds = compute_per_domain_thresholds()

    # Pick the most specific threshold
    threshold = effective_threshold or 65
    threshold_source = "global"
    if complexity_estimate and complexity_thresholds.get("ready"):
        ct = complexity_thresholds["thresholds"].get(str(complexity_estimate))
        if ct and ct.get("threshold"):
            threshold = ct["threshold"]
            threshold_source = f"complexity-{complexity_estimate}"

    # Find similar ideas
    similar = brain_similar_ideas(title, limit=5)

    # Compute estimated fit from similar ideas
    similar_fits = [s["eval_fit_score"] for s in similar if s.get("eval_fit_score")]
    estimated_fit = round(sum(similar_fits) / len(similar_fits), 1) if similar_fits else None

    # Ship rate at this complexity level
    ship_rate = None
    if complexity_estimate and complexity_thresholds.get("ready"):
        ct = complexity_thresholds["thresholds"].get(str(complexity_estimate))
        if ct:
            ship_rate = ct.get("ship_rate")

    # Domain fit
    domain_match = None
    if domain_thresholds.get("ready"):
        text = f"{title} {description}".lower()
        for d in domain_thresholds.get("domains", []):
            if any(kw in text for kw in d.get("keywords", [])):
                domain_match = d
                break

    # Make verdict
    confidence = 0.0
    reasons = []

    if estimated_fit is not None:
        if estimated_fit >= threshold + 10:
            verdict = "BUILD"
            confidence = min(0.95, 0.6 + len(similar_fits) * 0.07)
            reasons.append(f"Similar ideas averaged {estimated_fit} fit (threshold: {threshold})")
        elif estimated_fit >= threshold:
            verdict = "BUILD"
            confidence = min(0.8, 0.5 + len(similar_fits) * 0.05)
            reasons.append(f"Similar ideas near threshold ({estimated_fit} vs {threshold})")
        elif estimated_fit >= threshold - 10:
            verdict = "PARK"
            confidence = min(0.7, 0.4 + len(similar_fits) * 0.05)
            reasons.append(f"Similar ideas slightly below threshold ({estimated_fit} vs {threshold})")
        else:
            verdict = "SKIP"
            confidence = min(0.85, 0.55 + len(similar_fits) * 0.06)
            reasons.append(f"Similar ideas scored low ({estimated_fit} vs {threshold})")
    else:
        # No similar ideas — use domain and complexity heuristics
        verdict = "PARK"
        confidence = 0.3
        reasons.append("No similar evaluated ideas found")

    if ship_rate is not None:
        if ship_rate >= 0.5:
            reasons.append(f"Complexity {complexity_estimate} has {int(ship_rate*100)}% ship rate")
            confidence = min(0.95, confidence + 0.1)
        elif ship_rate < 0.2 and ship_rate > 0:
            reasons.append(f"Complexity {complexity_estimate} has only {int(ship_rate*100)}% ship rate")
            if verdict == "BUILD":
                verdict = "PARK"
                confidence = max(0.4, confidence - 0.15)

    if domain_match:
        if domain_match.get("ship_rate", 0) >= 0.3:
            reasons.append(f"Domain '{domain_match['domain']}' has {int(domain_match['ship_rate']*100)}% ship rate")
            confidence = min(0.95, confidence + 0.1)
        elif domain_match.get("ship_rate", 0) == 0 and domain_match.get("total", 0) >= 3:
            reasons.append(f"Domain '{domain_match['domain']}' has 0% ship rate ({domain_match['total']} ideas)")

    return {
        "verdict": verdict,
        "confidence": round(confidence, 2),
        "reason": ". ".join(reasons) + ".",
        "effective_threshold": threshold,
        "threshold_source": threshold_source,
        "estimated_fit": estimated_fit,
        "ship_rate_at_complexity": ship_rate,
        "similar_count": len(similar),
        "similar_ideas": [{"id": s["id"], "title": s.get("video_title", "")[:60], "fit": s.get("eval_fit_score"), "verdict": s.get("eval_verdict"), "outcome": s.get("outcome")} for s in similar[:3]],
    }


def brain_similar_ideas(title: str, limit: int = 5) -> list:
    """Find past ideas with similar titles/topics and their outcomes."""
    if not title:
        return []
    query_words = set(_normalize_title(title).split())
    if not query_words:
        return []

    with db() as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute("""
            SELECT id, video_title, eval_fit_score, eval_verdict, eval_complexity,
                   eval_one_sentence, outcome, source_kind
            FROM ideas WHERE eval_verdict IS NOT NULL
        """).fetchall()

    scored = []
    for r in rows:
        idea_words = set(_normalize_title(r["video_title"] or "").split())
        if not idea_words:
            continue
        overlap = len(query_words & idea_words) / min(len(query_words), len(idea_words))
        if overlap >= 0.3:
            scored.append((overlap, dict(r)))

    scored.sort(key=lambda x: x[0], reverse=True)
    return [s[1] for s in scored[:limit]]


def compute_per_domain_thresholds() -> dict:
    """Compute per-domain thresholds from outcome data grouped by eval topic keywords."""
    with db() as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute("""
            SELECT id, video_title, eval_fit_score, eval_verdict, eval_one_sentence, outcome
            FROM ideas WHERE eval_verdict IS NOT NULL AND eval_fit_score IS NOT NULL
        """).fetchall()

    if len(rows) < 5:
        return {"ready": False, "min_needed": 5, "current": len(rows)}

    # Extract simple domain keywords from titles and one-sentences
    domain_keywords = {}
    keyword_list = ["cli", "api", "dashboard", "bot", "agent", "automation",
                    "saas", "tool", "plugin", "extension", "scraper",
                    "monitor", "tracker", "generator", "analyzer", "pipeline"]

    for r in rows:
        text = f"{r['video_title'] or ''} {r['eval_one_sentence'] or ''}".lower()
        for kw in keyword_list:
            if kw in text:
                domain_keywords.setdefault(kw, []).append(dict(r))

    domains = []
    for kw, items in sorted(domain_keywords.items(), key=lambda x: -len(x[1])):
        if len(items) < 2:
            continue
        shipped = [i["eval_fit_score"] for i in items if i["outcome"] == "shipped" and i["eval_fit_score"]]
        not_shipped = [i["eval_fit_score"] for i in items if i["outcome"] in ("abandoned", "pivoted") and i["eval_fit_score"]]
        build_count = sum(1 for i in items if i["eval_verdict"] == "BUILD")
        ship_count = sum(1 for i in items if i["outcome"] == "shipped")
        threshold = None
        if shipped and not_shipped:
            threshold = round((sum(shipped)/len(shipped) + sum(not_shipped)/len(not_shipped)) / 2, 1)
        domains.append({
            "domain": kw,
            "keywords": [kw],
            "total": len(items),
            "build_count": build_count,
            "ship_count": ship_count,
            "ship_rate": round(ship_count / build_count, 3) if build_count else None,
            "threshold": threshold,
            "avg_fit": round(sum(i["eval_fit_score"] for i in items if i["eval_fit_score"]) / max(1, len([i for i in items if i["eval_fit_score"]])), 1),
        })

    return {"ready": True, "domains": domains}


def brain_topic_fit(topic_keywords: list) -> dict:
    """How well a topic matches the founder's shipping history."""
    domains = compute_per_domain_thresholds()
    if not domains.get("ready"):
        return {"ready": False, "reason": "Not enough data"}
    matches = [d for d in domains["domains"] if any(kw in d["keywords"] for kw in topic_keywords)]
    if not matches:
        return {"ready": True, "match": None, "reason": "No matching domain found in history"}
    best = max(matches, key=lambda d: d.get("ship_rate") or 0)
    return {"ready": True, "match": best["domain"], "ship_rate": best.get("ship_rate"),
            "threshold": best.get("threshold"), "total": best.get("total")}


def brain_calibration() -> dict:
    """Current calibration snapshot — threshold, ship rates, confidence."""
    with db() as conn:
        conn.row_factory = sqlite3.Row
        row = conn.execute("SELECT * FROM calibration_log ORDER BY id DESC LIMIT 1").fetchone()
    if row:
        return {"ready": True, **dict(row)}
    return {"ready": False, "reason": "No outcomes tracked yet. Set outcomes on evaluated ideas to calibrate."}


