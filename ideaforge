def worker_loop():
    while not STOP.is_set():
        try:
            job = JOBQ.get(timeout=0.5)
        except queue.Empty:
            continue
        try:
            print(f"Starting job: {job['kind']} for idea {job['idea_id']}")
            handle_job(job)
        except Exception as e:
            print(f"Worker exception: {e}")
        finally:
            JOBQ.task_done()

