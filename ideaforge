class Handler(BaseHTTPRequestHandler):
    def _json(self, payload, status=200):
        data = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _guard(self, post=False):
        """Refuse DNS-rebinding and cross-site requests. The server is loopback only, so the Host must be this
        server's own address; a browser page on another origin must not be able to drive it."""
        headers = getattr(self, "headers", None)
        if headers is None:                                    # unit tests call handlers without a socket
            return True
        port = self.server.server_port
        ok = headers.get("Host", "") in (f"127.0.0.1:{port}", f"localhost:{port}")
        origin = headers.get("Origin")
        if ok and origin is not None:
            ok = origin in (f"http://127.0.0.1:{port}", f"http://localhost:{port}")
        if ok and post:
            ok = headers.get("Content-Type", "").split(";")[0].strip().lower() == "application/json"
        if not ok:
            self._json({"ok": False, "error": "forbidden"}, 403)
        return ok

    def _read_json(self):
        n = int(self.headers.get("Content-Length", "0"))
        if n <= 0 or n > 1024 * 1024:
            return None
        raw = self.rfile.read(n)
        return json.loads(raw.decode("utf-8"))

    def do_GET(self):
        if not self._guard():
            return
        if self.path == "/api/scout":
            self._json({"ok": True, "runs": scout_runs()})
            return

        card_match = re.fullmatch(r"/api/card/(\d+)\.md", urlparse(self.path).path)
        if card_match:
            idea_id = int(card_match.group(1))
            with db() as conn:
                conn.row_factory = sqlite3.Row
                row = conn.execute("SELECT * FROM ideas WHERE id=?", (idea_id,)).fetchone()
                if row is None:
                    self._json({"ok": False, "error": "idea not found"}, 404)
                    return
                idea = dict(row)
                idea.update(idea_details(idea))
                demand_rows = [dict(item) for item in conn.execute(
                    "SELECT platform, url, title, engagement, fetched_at FROM demand "
                    "WHERE idea_id=? ORDER BY fetched_at DESC", (idea_id,))]
            data = demand_card.to_markdown(
                demand_card.build_card(idea, demand_rows, idea.get("eval_verdict")))
            encoded = data.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/markdown; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)
            return

        if urlparse(self.path).path == "/api/markdown":
            query = parse_qs(urlparse(self.path).query)
            with db() as conn:
                conn.row_factory = sqlite3.Row
