        self._json({"ok": False, "error": "not found"}, 404)

    def do_POST(self):
        if not self._guard(post=True):
            return
        body = self._read_json()
        if body is None:
            self._json({"ok": False, "error": "invalid json"}, 400); return

        if self.path == "/api/hub/sync":
            try:
                result = hub_sync()
                evaluate_backlog()
                self._json({"ok": True, **result})
            except (OSError, ValueError) as error:
                self._json({"ok": False, "error": f"Hub sync failed: {error}"}, 400)
            return

        if self.path == "/api/factory/decision":
            try:
                if not isinstance(body, dict):
                    raise ValueError("Invalid decision")
                result = factory_decision(body.get("item"), body.get("action"))
                self._json(result, 200 if result["ok"] else 502)
            except (OSError, ValueError, sqlite3.Error) as error:
                self._json({"ok": False, "error": str(error)}, 400)
            return

        if self.path == "/api/ingest":
            url = (body.get("url") or "").strip()
            if not url:
                self._json({"ok": False, "error": "url/input required"}, 400); return
            try:
                source_kind, source_val = http_source(url)
            except PermissionError as error:
                self._json({"ok": False, "error": str(error)}, 403); return

            idea_id, added = ingest_idea(source_val, source_kind)
            self._json({"ok": True, "id": idea_id, "status": "queued" if added else "existing", "source_kind": source_kind})
            return

        if self.path == "/api/run-all":
            url = (body.get("url") or "").strip()
            if not url:
                self._json({"ok": False, "error": "url/input required"}, 400); return
            try:
                source_kind, source_val = http_source(url)
            except PermissionError as error:
                self._json({"ok": False, "error": str(error)}, 403); return

            idea_id, added = ingest_idea(source_val, source_kind, chain=["evaluate", "instruct"])
            self._json({"ok": True, "id": idea_id, "status": "queued: extract→evaluate→instruct" if added else "existing", "source_kind": source_kind})
            return

        if self.path.startswith("/api/run-all/"):
            idea_id = int(self.path.split("/")[-1])
            with db() as conn:
                row = conn.execute("SELECT youtube_url, extract_status, source_kind, source_path FROM ideas WHERE id=?", (idea_id,)).fetchone()
                if not row:
                    self._json({"ok": False, "error": "not found"}, 404); return
                url, extract_status, sk, sp = row

            if extract_status == "done":
                JOBQ.put({"kind": "evaluate", "idea_id": idea_id, "chain": ["instruct"]})
            else:
                JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": sp or url, "source_kind": sk or "youtube", "chain": ["evaluate", "instruct"]})
            self._json({"ok": True, "id": idea_id, "status": "queued run-all"})
            return

        if self.path.startswith("/api/outcome/"):
            idea_id = int(self.path.split("/")[-1])
            outcome = (body.get("outcome") or "").strip()
            if outcome not in ("shipped", "abandoned", "pivoted", "in_progress"):
                self._json({"ok": False, "error": "outcome must be shipped|abandoned|pivoted|in_progress"}, 400); return
            notes = (body.get("notes") or "").strip()[:2000]
            ts = now_iso()
            with db() as conn:
                conn.execute("UPDATE ideas SET outcome=?, outcome_notes=?, outcome_at=?, updated_at=? WHERE id=?",
                             (outcome, notes or None, ts, ts, idea_id))
                log_event(conn, idea_id, "outcome:set", outcome)
            compute_calibration()
            refresh_brief_counters(idea_id)
            self._json({"ok": True, "id": idea_id, "outcome": outcome})
            return

        # --- Brain Export ---
        if self.path == "/api/brain/export":
            try:
                brain = build_brain_export()
                self._json({"ok": True, "brain": brain})
            except Exception as e:
                self._json({"ok": False, "error": str(e)[:500]}, 500)
            return

        # --- Radar: create subscription ---
        if self.path == "/api/subscription":
            name = (body.get("name") or "").strip()
            kind = (body.get("kind") or "").strip()
            target = (body.get("target") or "").strip()
            if not name or not kind or not target:
                self._json({"ok": False, "error": "name, kind, and target required"}, 400); return
            if kind not in ("youtube_channel", "youtube_search", "rss_feed", "github_trending"):
                self._json({"ok": False, "error": "invalid subscription kind"}, 400); return
            if kind == "github_trending" and target not in ("daily", "weekly"):
                self._json({"ok": False, "error": "GitHub trending target must be daily or weekly"}, 400); return
            freq = int(body.get("frequency_hours", 24))
            max_items = int(body.get("max_items", 25 if kind == "github_trending" else 5))
            ts = now_iso()
            with db() as conn:
                cur = conn.execute("""
                    INSERT INTO subscriptions (name, kind, target, frequency_hours, max_items, auto_evaluate, enabled, created_at, updated_at)
                    VALUES (?, ?, ?, ?, ?, 1, 1, ?, ?)
                """, (name, kind, target, freq, max_items, ts, ts))
                sub_id = cur.lastrowid
            self._json({"ok": True, "id": sub_id, "status": "created"})
            return

        # --- Radar: update/toggle subscription ---
        if self.path.startswith("/api/subscription/") and self.path.endswith("/run"):
            try:
                sub_id = int(self.path.split("/")[3])
            except (ValueError, IndexError):
                self._json({"ok": False, "error": "invalid id"}, 400); return
            JOBQ.put({"kind": "radar_scan", "idea_id": 0, "sub_id": sub_id})
            self._json({"ok": True, "id": sub_id, "status": "scan queued"})
            return

        if self.path.startswith("/api/subscription/") and not self.path.endswith("/run"):
            try:
                sub_id = int(self.path.split("/")[-1])
            except (ValueError, IndexError):
                self._json({"ok": False, "error": "invalid id"}, 400); return
            action = body.get("action", "update")
            ts = now_iso()
            with db() as conn:
                if action == "toggle":
                    conn.execute("UPDATE subscriptions SET enabled=NOT enabled, updated_at=? WHERE id=?", (ts, sub_id))
                else:
                    for field in ("name", "target", "frequency_hours", "max_items"):
                        if field in body:
                            conn.execute(f"UPDATE subscriptions SET {field}=?, updated_at=? WHERE id=?", (body[field], ts, sub_id))
            self._json({"ok": True, "id": sub_id, "action": action})
            return

        if self.path == "/api/evaluate-backlog":
            try:
                queued = evaluate_backlog(body.get("limit", 20))
                self._json({"ok": True, "queued": queued})
            except (ValueError, AttributeError) as error:
                self._json({"ok": False, "error": str(error)}, 400)
            return

        if self.path.startswith("/api/evaluate/"):
            idea_id = int(self.path.split("/")[-1])
            JOBQ.put({"kind": "evaluate", "idea_id": idea_id})
            self._json({"ok": True, "id": idea_id, "status": "eval queued"})
            return

        if self.path.startswith("/api/instruct/"):
            idea_id = int(self.path.split("/")[-1])
            JOBQ.put({"kind": "instruct", "idea_id": idea_id})
            self._json({"ok": True, "id": idea_id, "status": "instruct queued"})
            return

        if self.path == "/api/search":
            query = (body.get("query") or "").strip()
            max_results = min(int(body.get("max_results", 5)), 20)
            if not query:
                self._json({"ok": False, "error": "empty query"}, 400); return
            results = youtube_search(query, max_results)
            self._json({"ok": True, "results": results, "query": query})
            return

        if self.path == "/api/bulk-ingest":
            urls = body.get("urls", [])
            run_all = body.get("run_all", False)
            if not urls or not isinstance(urls, list):
                self._json({"ok": False, "error": "urls must be a non-empty list"}, 400); return
            ids = []
            ts = now_iso()
            for url in urls:
                url = (url or "").strip()
                if not valid_youtube_url(url):
                    continue
                with db() as conn:
                    cur = conn.execute("""
                        INSERT INTO ideas (youtube_url, extract_status, eval_status, instr_status, created_at, updated_at)
                        VALUES (?, 'pending', 'pending', 'pending', ?, ?)
                    """, (url, ts, ts))
                    idea_id = cur.lastrowid
                    log_event(conn, idea_id, "bulk-ingest", url)
                chain = ["evaluate", "instruct"] if run_all else []
                JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": url, "chain": chain})
                ids.append(idea_id)
            self._json({"ok": True, "ids": ids, "count": len(ids)})
            return

        if self.path == "/api/notebook":
            name = (body.get("name") or "").strip()
            idea_ids = body.get("idea_ids", [])
            if not name:
                self._json({"ok": False, "error": "name required"}, 400); return
            if not idea_ids:
                self._json({"ok": False, "error": "idea_ids required"}, 400); return
            if not NLM_AVAILABLE:
                self._json({"ok": False, "error": "nlm CLI not available"}, 503); return
