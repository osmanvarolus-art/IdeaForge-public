def log_event(conn, idea_id: int, kind: str, detail: str = ""):
    conn.execute("INSERT INTO events (idea_id, ts, kind, detail) VALUES (?, ?, ?, ?)",
                 (idea_id, now_iso(), kind, detail[:8000]))

def youtube_identity(url):
    try:
        return _youtube_id(url) if urlparse(url).scheme in ("http", "https") else None
    except (ValueError, TypeError, AttributeError):
        return None


def local_file_allowed(path):
    """Files named over HTTP must sit inside the inbox folder (IDEAFORGE_INBOX, default ./inbox); the CLI is not limited."""
    root = os.path.realpath(os.environ.get("IDEAFORGE_INBOX", os.path.join(os.path.dirname(os.path.abspath(__file__)), "inbox")))
    real = os.path.realpath(path)
    return real == root or real.startswith(root + os.sep)


def inbox_path(path):
    """Resolve once and return the real path when it sits inside the inbox, else None. Workers call this right before opening
    a file, so a file swapped for a symlink after the request was accepted is still refused."""
    real = os.path.realpath(path)
    return real if local_file_allowed(real) and os.path.isfile(real) and not os.path.islink(real) else None


def http_source(url):
    """detect_source_kind for a request that came over HTTP: a local file outside the inbox is refused."""
    kind, val = detect_source_kind(url)
    if kind in ("pdf", "text") and os.path.isfile(val) and not local_file_allowed(val):
        raise PermissionError("local files are only read from the inbox folder")
    return kind, val


def ingest_idea(url, source_kind, *, title=None, source=None, chain=None, content=None):
    """Share the manual and hub queue path; serialize video identity checks with inserts."""
    video_id = youtube_identity(url)
    with db() as conn:
        conn.execute("BEGIN IMMEDIATE")
        if source_kind == "github_repo":
            kind, url = detect_source_kind(url)
            if kind != "github_repo":
                raise ValueError("invalid GitHub repository URL")
            existing = conn.execute(
                "SELECT id FROM ideas WHERE lower(source_path)=? OR lower(youtube_url)=?",
                (url, url)).fetchone()
            if existing:
                conn.commit()
                return existing[0], False
        if video_id:
            for existing_id, existing_url in conn.execute("SELECT id, youtube_url FROM ideas"):
                if youtube_identity(existing_url) == video_id:
                    conn.commit()
                    return existing_id, False
        ts = now_iso()
        cur = conn.execute("""INSERT INTO ideas
            (youtube_url, video_title, source_kind, source_path, intake_source,
             transcript_preview, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (url if source_kind == "youtube" else "", title, source_kind,
             None if source_kind == "youtube" else url, source, content, ts, ts))
        idea_id = cur.lastrowid
        log_event(conn, idea_id, "ingest", f"{source_kind}:{url[:200]}")
        conn.commit()
    JOBQ.put({"kind": "extract", "idea_id": idea_id, "url": url,
              "source_kind": source_kind, "chain": list(chain or [])})
    return idea_id, True


def hub_sync():
    """Read the collectors' snapshot without modifying it or their decision history."""
    refresh_factory_outcomes()
    path = os.path.expanduser(os.environ.get("IDEAFORGE_HUB_FILE",
                                            "~/.local/state/harvest-hub/candidates.jsonl"))
    limit = max(0, int(os.environ.get("IDEAFORGE_HUB_MAX_PER_RUN", "20")))
    rows = []
    with open(path, encoding="utf-8") as stream:
        for line in stream:
            try:
                row = json.loads(line)
                if not isinstance(row, dict) or any(not isinstance(row.get(k), str) or not row[k].strip()
                        for k in ("id", "kind", "title", "summary", "url", "seen_at")):
                    continue
                sources = row.get("source")
                sources = sources if isinstance(sources, list) else [sources]
                if not sources or any(not isinstance(s, str) or not s.strip() for s in sources):
                    continue
                stamp = datetime.fromisoformat(row["seen_at"].replace("Z", "+00:00"))
                if stamp.tzinfo is None:
                    stamp = stamp.replace(tzinfo=timezone.utc)
                history = isinstance(row.get("techniques"), list) and "youtube-history" in row["techniques"]
                rows.append((history, stamp.timestamp(), row, ", ".join(sources)))
            except (ValueError, TypeError, OverflowError):
                continue
    counts = {"queued": 0, "cards_added": 0, "skipped_duplicate": 0}
    # Serialize syncs; ingest_idea also checks identity atomically against manual intake.
    with HUB_SYNC_LOCK:
        for _, _, row, source in sorted(rows, key=lambda r: (r[0], r[1]), reverse=True):
            if row["kind"] == "video" and youtube_identity(row["url"]):
                with db() as conn:
                    exists = any(youtube_identity(url) == youtube_identity(row["url"])
                                 for (url,) in conn.execute("SELECT youtube_url FROM ideas"))
                if exists:
                    counts["skipped_duplicate"] += 1
                    continue
                if counts["queued"] >= limit:
                    continue
                _, added = ingest_idea(row["url"], "youtube", title=row["title"], source=source)
                counts["queued" if added else "skipped_duplicate"] += 1
            elif row["kind"] in {"repo", "paper", "article", "idea", "model"}:
                with db() as conn:
                    cur = conn.execute("INSERT OR IGNORE INTO hub_cards VALUES (?, ?, ?, ?, ?, ?, ?)",
                        (row["id"], row["kind"], row["title"], row["summary"], row["url"], source, row["seen_at"]))
                    counts["cards_added" if cur.rowcount else "skipped_duplicate"] += 1
    return counts


HUB_SYNC_LOCK = threading.Lock()


def read_json_object(path):
    try:
        with open(path, encoding="utf-8") as stream:
            value = json.load(stream)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def scout_runs():
    """Project the append-only history; never change Scout's lifecycle or evidence."""
    path = os.path.expanduser(os.environ.get("IDEAFORGE_SCOUT_HISTORY",
                                           "~/.local/state/north-star/scout/history.jsonl"))
    runs = {}
    try:
        with open(path, encoding="utf-8") as stream:
            for line in stream:
                try:
                    row = json.loads(line)
                    if isinstance(row, dict) and isinstance(row.get("id"), str) and re.fullmatch(r"[A-Za-z0-9_-]+", row["id"]):
                        runs.pop(row["id"], None)
                        runs[row["id"]] = row
                except ValueError:
                    continue
    except OSError:
        return []
    result = []
    for run_id, row in reversed(list(runs.items())):
        data = row.get("data") if isinstance(row.get("data"), dict) else {}
        decision = data.get("decide") or row.get("result") or {}
        decision = decision if isinstance(decision, dict) else {}
        outcome = read_json_object(os.path.join(os.path.dirname(path), run_id, "outcome.json"))
        result.append({"id": run_id, "stage": row.get("stage"),
                       "decision": "BUILD" if str(decision.get("decision", "")).lower() == "build" else "none",
                       "reason": decision.get("reasons") or row.get("reason") or [],
                       "product": decision.get("winner") or outcome.get("product_id"),
                       "product_state": outcome.get("outcome"), "outcome": outcome})
    return result


