class _NoRelayRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None  # Never forward the bearer credential to a redirect target.


def _openai_json(endpoint, payload=None):
    """Read credentials at request time; expose neither upstream errors nor echoed keys."""
    try:
        base = OPENAI_BASE_URL.rstrip("/")
        parsed = urlparse(base)
        if parsed.scheme not in {"http", "https"} or not parsed.netloc or parsed.username \
                or parsed.password or parsed.query or parsed.fragment:
            raise ValueError("invalid relay URL")
        with open(os.environ.get("IDEAFORGE_OPENAI_KEY_FILE", ""), encoding="utf-8") as stream:
            key = json.load(stream)["apiKey"]
        if not isinstance(key, str) or not key or any(char.isspace() for char in key):
            raise ValueError("invalid relay credential")
        request = urllib.request.Request(base + "/" + endpoint,
            data=None if payload is None else json.dumps(payload).encode("utf-8"),
            headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"})
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRelayRedirect())
        with opener.open(request, timeout=120) as response:
            result = json.loads(response.read())

        def scrub(value):
            if isinstance(value, str):
                return value.replace(key, "[redacted]")
            if isinstance(value, list):
                return [scrub(item) for item in value]
            if isinstance(value, dict):
                return {scrub(name): scrub(item) for name, item in value.items()}
            return value

        return scrub(result)
    except urllib.error.HTTPError as error:
        error.close()
    except Exception:
        # Transport errors can include a credential echoed in a malformed status line.
        pass
    raise RuntimeError("OpenAI-compatible request failed") from None


def _openai_models():
    global MODEL
    try:
        available = {row["id"] for row in _openai_json("models")["data"]
                     if isinstance(row, dict) and isinstance(row.get("id"), str)}
        preferences = dict.fromkeys(model.strip() for model in
            os.environ.get("IDEAFORGE_OPENAI_MODELS", "").split(",") if model.strip())
        models = [model for model in preferences if model in available]
        if not models:
            raise ValueError("no preferred model available")
    except (RuntimeError, ValueError, TypeError, KeyError):
        MODEL = None
        raise RuntimeError("OpenAI-compatible models unavailable") from None
    if MODEL not in models:
        MODEL = models[0]
    return models


def llm_call(prompt: str, max_tokens: int = 1400, temperature: float = 0.2, *, grounding_urls=None, validate=None, model_info=None):
    """Unified LLM call. Returns (text, input_tokens, output_tokens)."""
    global MODEL
    if ai_backend == "openai-compatible":
        validation_error = None
        for model in _openai_models():
            if model_info is not None:
                model_info["model"] = model
            try:
                response = _openai_json("chat/completions", {
                    "model": model, "messages": [{"role": "user", "content": prompt}],
                    "max_tokens": max_tokens, "temperature": temperature})
                text = response["choices"][0]["message"]["content"]
                if validate is None and (not isinstance(text, str) or not text.strip()):
                    raise ValueError("empty completion")
                usage = response.get("usage") or {}
                in_tok, out_tok = usage.get("prompt_tokens"), usage.get("completion_tokens")
            except (RuntimeError, KeyError, IndexError, TypeError, ValueError, AttributeError):
                if validation_error is not None:
                    break  # The one fallback after an invalid answer also failed.
                continue
            if validate is not None:
                try:
                    validate(text)
                except ValueError as error:
                    if validation_error is not None:
                        break
                    validation_error = error
                    continue
            MODEL = model
            return text, in_tok, out_tok
        if validation_error is not None:
            raise validation_error
        raise RuntimeError("OpenAI-compatible models failed")
    elif ai_backend == "gemini":
        if model_info is not None:
            model_info["model"] = MODEL
        config = {"max_output_tokens": max_tokens, "temperature": temperature}
        if grounding_urls is not None:
            from google.genai import types as gtypes
            config = gtypes.GenerateContentConfig(
                tools=[gtypes.Tool(google_search=gtypes.GoogleSearch())], **config)
        resp = gemini_client.models.generate_content(
            model=MODEL,
            contents=prompt,
            config=config,
        )
        text = resp.text or ""
        if grounding_urls is not None and getattr(resp, "candidates", None):
            metadata = getattr(resp.candidates[0], "grounding_metadata", None)
            for chunk in (getattr(metadata, "grounding_chunks", None) or []):
                web = getattr(chunk, "web", None)
                if web and getattr(web, "uri", ""):
                    grounding_urls[web.uri] = getattr(web, "title", "")
        usage = getattr(resp, "usage_metadata", None)
        in_tok = getattr(usage, "prompt_token_count", None)
        out_tok = getattr(usage, "candidates_token_count", None)
        return text, in_tok, out_tok
    elif ai_backend == "anthropic":
        if model_info is not None:
            model_info["model"] = MODEL
        msg = anthropic_client.messages.create(
            model=MODEL,
            max_tokens=max_tokens,
            temperature=temperature,
            messages=[{"role": "user", "content": prompt}],
        )
        text = msg.content[0].text if msg.content else ""
        usage = getattr(msg, "usage", None)
        in_tok = getattr(usage, "input_tokens", None)
        out_tok = getattr(usage, "output_tokens", None)
        return text, in_tok, out_tok
    else:
        raise RuntimeError("No AI backend configured")

