def compute_research_funnel():
    """Compute cross-run research-to-ship funnel analytics."""
    with db() as conn:
        conn.row_factory = sqlite3.Row
        runs = conn.execute("SELECT * FROM research_runs WHERE status='done'").fetchall()
        total_runs = len(runs)
        if total_runs == 0:
            return {"ready": False, "total_runs": 0}

        total_candidates = sum(r["total_candidates"] for r in runs)
        total_above = sum(r["total_above_threshold"] for r in runs)
        total_ingested = sum(r["total_ingested"] for r in runs)

        # Count ideas from research that got BUILD verdict
        build_count = conn.execute("""
            SELECT COUNT(*) FROM ideas i
            JOIN research_results rr ON i.research_result_id = rr.id
            WHERE i.eval_verdict = 'BUILD'
        """).fetchone()[0]

        # Count ideas from research that were shipped
        shipped_count = conn.execute("""
            SELECT COUNT(*) FROM ideas i
            JOIN research_results rr ON i.research_result_id = rr.id
            WHERE i.outcome = 'shipped'
        """).fetchone()[0]

    research_to_ship = round(shipped_count / total_candidates, 4) if total_candidates > 0 else None
    return {
        "ready": True,
        "total_runs": total_runs,
        "total_candidates": total_candidates,
        "total_above_threshold": total_above,
        "total_ingested": total_ingested,
        "total_build": build_count,
        "total_shipped": shipped_count,
        "research_to_ship_rate": research_to_ship,
        "rates": {
            "above_pct": round(total_above / total_candidates * 100, 1) if total_candidates else 0,
            "ingest_pct": round(total_ingested / total_above * 100, 1) if total_above else 0,
            "build_pct": round(build_count / total_ingested * 100, 1) if total_ingested else 0,
            "ship_pct": round(shipped_count / build_count * 100, 1) if build_count else 0,
        }
    }


def compute_per_complexity_thresholds():
    """Compute effective threshold per complexity bucket from outcome data."""
    with db() as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute("""
            SELECT eval_complexity, eval_fit_score, outcome, eval_verdict
            FROM ideas WHERE eval_verdict IS NOT NULL AND eval_complexity IS NOT NULL
        """).fetchall()

    if len(rows) < 5:
        return {"ready": False, "min_needed": 5, "current": len(rows)}

    by_complexity = {}
    for r in rows:
        c = r["eval_complexity"]
        by_complexity.setdefault(c, []).append(r)

    thresholds = {}
    for c, items in sorted(by_complexity.items()):
        shipped = [i["eval_fit_score"] for i in items if i["outcome"] == "shipped" and i["eval_fit_score"]]
        not_shipped = [i["eval_fit_score"] for i in items if i["outcome"] in ("abandoned", "pivoted") and i["eval_fit_score"]]
        build_count = sum(1 for i in items if i["eval_verdict"] == "BUILD")
        ship_count = sum(1 for i in items if i["outcome"] == "shipped")
        threshold = None
        if shipped and not_shipped:
            threshold = round((sum(shipped)/len(shipped) + sum(not_shipped)/len(not_shipped)) / 2, 1)
        thresholds[str(c)] = {
            "total": len(items),
            "build_count": build_count,
            "ship_count": ship_count,
            "ship_rate": round(ship_count / build_count, 3) if build_count else None,
            "threshold": threshold,
            "avg_fit": round(sum(i["eval_fit_score"] for i in items if i["eval_fit_score"]) / max(1, sum(1 for i in items if i["eval_fit_score"])), 1),
        }

    return {"ready": True, "thresholds": thresholds}


def compute_topic_performance():
    """Compute research topic performance from briefs that have runs."""
    with db() as conn:
        conn.row_factory = sqlite3.Row
        briefs = conn.execute("SELECT * FROM research_briefs ORDER BY total_runs DESC").fetchall()
        if not briefs:
            return {"ready": False, "total_briefs": 0}

        topics = []
        for b in briefs:
            # Count BUILD verdicts and shipped outcomes for ideas from this brief's runs
            build_count = conn.execute("""
                SELECT COUNT(*) FROM ideas i
                JOIN research_results rr ON i.research_result_id = rr.id
                JOIN research_runs rn ON rr.run_id = rn.id
                WHERE rn.brief_id = ? AND i.eval_verdict = 'BUILD'
            """, (b["id"],)).fetchone()[0]
            shipped_count = conn.execute("""
                SELECT COUNT(*) FROM ideas i
                JOIN research_results rr ON i.research_result_id = rr.id
                JOIN research_runs rn ON rr.run_id = rn.id
                WHERE rn.brief_id = ? AND i.outcome = 'shipped'
            """, (b["id"],)).fetchone()[0]
            topics.append({
                "brief_id": b["id"],
                "name": b["name"],
                "prompt": b["prompt"][:100],
                "total_runs": b["total_runs"],
                "total_ingested": b["total_ingested"],
                "total_built": build_count,
                "total_shipped": shipped_count,
                "ship_rate": round(shipped_count / b["total_ingested"], 3) if b["total_ingested"] > 0 else None,
            })

    return {"ready": True, "topics": topics}


