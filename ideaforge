                    for row in conn.execute("SELECT * FROM " + table + " ORDER BY id"):
                        item = kind + ":" + str(row["id"])
                        selected = states.get(item, {}).get("favourite") if query.get("favourites") == ["1"] else query.get("item") == [item]
                        if selected:
                            texts.append(card_markdown(dict(row), kind))
                self._json({"ok": True, "markdown": "\n---\n\n".join(texts)})
            return

        if self.path == "/":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            with open(os.path.join(ROOT, "index.html"), encoding="utf-8") as f:
                page = f.read()
            # The existing page defines sourceBadge but leaves it unused on idea cards.
            page = page.replace(
                """'<div class="icv-title">' + esc(i.video_title || 'Untitled')""",
