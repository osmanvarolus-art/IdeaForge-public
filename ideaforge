                           i.extract_duration_ms, i.eval_duration_ms, i.instr_duration_ms,
                           i.last_error, i.transcript_preview
                    FROM ideas i JOIN idea_notebooks inb ON i.id = inb.idea_id
                    WHERE inb.notebook_id=?
                    ORDER BY i.id ASC
                """, (notebook_id,)).fetchall()
                idea_list = [dict(r) for r in ideas]
                extracted = sum(1 for i in idea_list if i["extract_status"] == "done")
                evaluated = sum(1 for i in idea_list if i["eval_status"] == "done")
                instructed = sum(1 for i in idea_list if i["instr_status"] == "done")
                failed = sum(1 for i in idea_list if "failed" in (i["extract_status"], i["eval_status"], i["instr_status"]))
                total = len(idea_list)
                all_done = total > 0 and (instructed + failed == total)
                self._json({
                    "ok": True,
                    "notebook": dict(nb),
                    "ideas": idea_list,
                    "progress": {
                        "total": total, "extracted": extracted, "evaluated": evaluated,
                        "instructed": instructed, "failed": failed, "all_done": all_done
                    }
                })
            return

        if self.path.startswith("/api/notebook/") and "/generate" not in self.path and "/finalize" not in self.path:
