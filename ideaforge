def handle_job(job: dict):
    kind = job["kind"]
    idea_id = job.get("idea_id", 0)
    chain = job.get("chain", [])

    ok = False
    if kind == "extract":
        source_kind = job.get("source_kind", "youtube")
        if source_kind == "github_repo":
            ok = extract_github_repo_job(idea_id)
        elif source_kind == "pdf":
            ok = extract_pdf_job(idea_id, job["url"])
        elif source_kind == "rss":
            ok = extract_rss_job(idea_id, job["url"])
        elif source_kind == "text":
            ok = extract_text_job(idea_id, job["url"])
        else:
            ok = extract_transcript_job(idea_id, job["url"])
    elif kind == "evaluate":
        ok = evaluate_job(idea_id)
        if ok:
            try:
                with db() as conn:
                    row = conn.execute("SELECT video_title, eval_one_sentence, eval_status FROM ideas WHERE id=?", (idea_id,)).fetchone()
                if row and row[2] == "done":
                    query = (row[0] or "").strip() or " ".join((row[1] or "").split()[:8])
                    results = demand_probe.probe(query) if query else []
                    with db() as conn:
                        count, platforms = demand_probe.store(conn, idea_id, results)
                        log_event(conn, idea_id, "demand", f"demand: {count} posts from {platforms} platforms")
                        for result in results:
                            if "error" in result:
                                log_event(conn, idea_id, "demand:error", result["platform"] + ": " + result["error"][:500])
            except Exception as exc:
                with db() as conn:
                    log_event(conn, idea_id, "demand:error", str(exc)[:500])
    elif kind == "instruct":
        ok = instruct_job(idea_id)
    elif kind == "notebook_create":
        ok = notebook_create_job(job["notebook_id"])
    elif kind == "notebook_generate":
        ok = notebook_generate_job(job["notebook_id"])
    elif kind == "radar_scan":
        radar_scan_subscription(job["sub_id"])
        ok = True
    elif kind == "research_run":
        ok = research_run_job(job["run_id"])
    elif kind == "hub_sync":
        hub_sync()
        evaluate_backlog()
        ok = True

    if ok and chain:
        nxt = chain.pop(0)
        JOBQ.put({"kind": nxt, "idea_id": idea_id, "chain": chain})
    return ok

def load_pending_jobs():
    with db() as conn:
